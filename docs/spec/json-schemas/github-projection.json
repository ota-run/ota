{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/github-projection.json",
  "title": "ota ci github <render|check|sync> --json",
  "$defs": {
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "semantic_contract_identity", "workflow", "task", "mode", "target_os", "merge_check_ids", "refusal_canaries", "toolchains", "proof_required", "proof_claim", "bootstrap", "governance", "ownership", "identity"],
      "properties": {
        "schema_version": { "const": 1 },
        "semantic_contract_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "workflow": { "type": "string" },
        "task": { "type": "string" },
        "mode": { "enum": ["native", "container", "remote"] },
        "target_os": { "enum": ["linux", "macos", "windows"] },
        "merge_check_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "refusal_canaries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target", "merge_check_id"],
            "properties": {
              "kind": { "enum": ["task", "workflow"] },
              "target": { "type": "string" },
              "merge_check_id": { "type": "string" }
            }
          }
        },
        "toolchains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source", "version", "execution_scopes"],
            "properties": {
              "name": { "type": "string" },
              "source": { "enum": ["rustup", "corepack", "sdkman", "uv", "go", "ruby", "dotnet", "mise", "unspecified"] },
              "version": { "type": "string" },
              "execution_scopes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["native", "container", "remote"] }
              }
            }
          }
        },
        "proof_required": { "type": "boolean" },
        "proof_claim": { "type": ["string", "null"] },
        "bootstrap": {
          "type": "object", "additionalProperties": false, "required": ["source_kind"],
          "properties": { "source_kind": { "enum": ["version", "git_rev", "branch", "unspecified"] }, "source_identity": { "type": "string" } }
        },
        "governance": {
          "type": "object", "additionalProperties": false, "required": ["agent_admission"],
          "properties": {
            "agent_admission": {
              "type": "object", "additionalProperties": false, "required": ["decision", "basis"],
              "properties": { "decision": { "enum": ["allow", "deny", "review", "unresolved"] }, "basis": { "type": "array", "items": { "type": "string" } } }
            },
            "proof_assurance": {
              "type": "object", "additionalProperties": false, "required": ["status", "policy_decision", "basis"],
              "properties": { "status": { "enum": ["supported", "contradicted", "unknown"] }, "policy_decision": { "enum": ["allow", "deny", "review"] }, "basis": { "type": "array", "items": { "type": "string" } } }
            }
          }
        },
        "ownership": {
          "type": "object", "additionalProperties": false, "required": ["ota_owned", "provider_owned", "required_bindings"],
          "properties": { "ota_owned": { "type": "array", "items": { "type": "string" } }, "provider_owned": { "type": "array", "items": { "type": "string" } }, "required_bindings": { "type": "array", "items": { "type": "string" } } }
        },
        "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "github_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["projection", "runner", "provider_checks", "content_identity", "render_identity", "rendered"],
      "properties": {
        "projection": { "$ref": "#/$defs/projection" },
        "runner": { "type": "string" },
        "provider_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["merge_check_id", "provider_check_name"],
            "properties": {
              "merge_check_id": { "type": "string" },
              "provider_check_name": { "type": "string" }
            }
          }
        },
        "content_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "render_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "rendered": { "type": "string" }
      }
    }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "operation", "projection", "mutated"],
      "properties": {
        "ok": { "const": true },
        "operation": { "enum": ["render", "check", "sync"] },
        "projection": { "$ref": "#/$defs/github_projection" },
        "output_path": { "type": ["string", "null"] },
        "caller_path": { "type": "string" },
        "binding_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "mutated": { "type": "boolean" }
      },
      "allOf": [{ "if": { "properties": { "operation": { "enum": ["check", "sync"] } } }, "then": { "required": ["caller_path", "binding_identity"] } }]
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "code", "message"],
      "properties": { "ok": { "const": false }, "code": { "type": "string" }, "message": { "type": "string" } }
    }
  ]
}
