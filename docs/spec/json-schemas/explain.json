{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/explain.json",
  "title": "ota explain --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "summary", "steps"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_count", "warn_count", "info_count", "step_count"],
      "properties": {
        "error_count": { "type": "integer", "minimum": 0 },
        "warn_count": { "type": "integer", "minimum": 0 },
        "info_count": { "type": "integer", "minimum": 0 },
        "step_count": { "type": "integer", "minimum": 0 }
      }
    },
        "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "code", "severity", "summary", "why", "next"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "code": { "type": "string" },
          "severity": { "enum": ["error", "warn", "info"] },
          "summary": { "type": "string" },
          "why": { "type": "string" },
          "next": { "type": "string" },
          "provenance": { "type": "string" }
        }
      }
    }
  }
}
