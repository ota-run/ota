{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/assist-declare-env.json",
  "title": "ota assist declare-env --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "path",
        "mode",
        "operation",
        "subject",
        "inputs",
        "assumptions",
        "changes",
        "diff",
        "validation",
        "next"
      ],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "mode": { "enum": ["preview", "write"] },
        "operation": { "const": "declare-env" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["root_var", "source", "task_env"] },
            "name": { "type": "string" },
            "task": { "type": "string" },
            "source_kind": { "enum": ["dotenv", "properties", "json", "yaml", "toml"] },
            "source_path": { "type": "string" }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": { "enum": ["true", "false"] },
            "secret": { "enum": ["true", "false"] },
            "default": { "type": "string" },
            "allowed": { "type": "string" },
            "prepend": { "type": "string" },
            "append": { "type": "string" },
            "source_kind": { "enum": ["dotenv", "properties", "json", "yaml", "toml"] },
            "source_path": { "type": "string" },
            "must_exist": { "enum": ["true", "false"] },
            "value": { "type": "string" }
          }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "before", "after"],
            "properties": {
              "path": { "type": "string" },
              "action": { "const": "set" },
              "before": {},
              "after": {}
            }
          }
        },
        "diff": { "type": "string" },
        "validation": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "operation", "subject", "why", "next"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "operation": { "const": "declare-env" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task": { "type": "string" },
            "name": { "type": "string" },
            "source_path": { "type": "string" }
          }
        },
        "why": { "type": "string" },
        "next": { "type": "string" }
      }
    }
  ]
}
