{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/workspace-check.json",
  "title": "ota workspace check --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "summary", "repos"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_count",
        "ready_count",
        "not_ready_count",
        "verdict",
        "agent_verdict",
        "error_count",
        "warn_count",
        "info_count"
      ],
      "properties": {
        "repo_count": { "type": "integer", "minimum": 0 },
        "ready_count": { "type": "integer", "minimum": 0 },
        "not_ready_count": { "type": "integer", "minimum": 0 },
        "verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "agent_verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "error_count": { "type": "integer", "minimum": 0 },
        "warn_count": { "type": "integer", "minimum": 0 },
        "info_count": { "type": "integer", "minimum": 0 }
      }
    },
    "finding_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_key", "action_title", "action_next", "count"],
        "properties": {
          "action_key": { "type": "string" },
          "action_title": { "type": "string" },
          "action_next": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "contract_path", "required", "ok", "findings"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "contract_path": { "type": "string" },
          "required": { "type": "boolean" },
          "ok": { "type": "boolean" },
          "agent_verdict": {
            "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
          },
          "primary_blocker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "summary", "why", "next"],
            "properties": {
              "severity": { "enum": ["error", "warn", "info"] },
              "summary": { "type": "string" },
              "why": { "type": "string" },
              "next": { "type": "string" },
              "provenance": { "type": "string" },
              "provenance_key": {
                "enum": ["org_policy", "repo_signals", "repo_contract"]
              }
            }
          },
          "findings": {
            "type": "array",
            "items": { "$ref": "./shared.json#/$defs/finding" }
          }
        }
      }
    }
  }
}
