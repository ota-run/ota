{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/env.json",
  "title": "ota env --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "summary", "env"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "task": { "type": "string" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_count",
            "task_count",
            "resolved_count",
            "missing_count",
            "invalid_count"
          ],
          "properties": {
            "contract_count": { "type": "integer" },
            "task_count": { "type": "integer" },
            "resolved_count": { "type": "integer" },
            "missing_count": { "type": "integer" },
            "invalid_count": { "type": "integer" }
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "required", "source", "status"],
            "properties": {
              "name": { "type": "string" },
              "kind": { "enum": ["contract", "task"] },
              "required": { "type": "boolean" },
              "default": { "type": "string" },
              "allowed": {
                "type": "array",
                "items": { "type": "string" }
              },
              "value": { "type": "string" },
              "source": { "type": "string" },
              "status": { "enum": ["resolved", "missing", "optional", "invalid", "task"] },
              "next": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "error"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "task": { "type": "string" },
        "error": { "type": "string" }
      }
    }
  ]
}
