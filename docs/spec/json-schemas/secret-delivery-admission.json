{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/secret-delivery-admission.json",
  "title": "Ota secret-delivery public admission projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "status",
    "applicable",
    "availability",
    "provider_contact",
    "delivery",
    "execution_started"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": { "enum": ["not_applicable", "refused"] },
    "applicable": { "type": "boolean" },
    "refusal_code": {
      "const": "secret_delivery_protected_truth_unavailable"
    },
    "availability": { "const": "not_checked" },
    "provider_contact": { "const": "not_attempted" },
    "delivery": { "const": "not_attempted" },
    "execution_started": { "const": false }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "not_applicable" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "applicable": { "const": false } },
        "not": { "required": ["refusal_code"] }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "refused" } },
        "required": ["status"]
      },
      "then": {
        "required": ["refusal_code"],
        "properties": {
          "applicable": { "const": true },
          "refusal_code": {
            "const": "secret_delivery_protected_truth_unavailable"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "applicable": { "const": true } },
        "required": ["applicable"]
      },
      "then": { "properties": { "status": { "const": "refused" } } }
    },
    {
      "if": {
        "properties": { "applicable": { "const": false } },
        "required": ["applicable"]
      },
      "then": { "properties": { "status": { "const": "not_applicable" } } }
    }
  ]
}
