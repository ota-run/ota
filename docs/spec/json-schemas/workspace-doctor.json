{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/workspace-doctor.json",
  "title": "ota workspace doctor --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "summary", "repos"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_count",
        "ready_count",
        "not_ready_count",
        "verdict",
        "agent_verdict",
        "error_count",
        "warn_count",
        "info_count"
      ],
      "properties": {
        "repo_count": { "type": "integer", "minimum": 0 },
        "ready_count": { "type": "integer", "minimum": 0 },
        "not_ready_count": { "type": "integer", "minimum": 0 },
        "verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "agent_verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "error_count": { "type": "integer", "minimum": 0 },
        "warn_count": { "type": "integer", "minimum": 0 },
        "info_count": { "type": "integer", "minimum": 0 }
      }
    },
    "repos": {
      "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "path", "contract_path", "required", "ok", "findings"],
          "properties": {
            "name": { "type": "string" },
            "path": { "type": "string" },
            "contract_path": { "type": "string" },
            "required": { "type": "boolean" },
            "ok": { "type": "boolean" },
            "agent_verdict": {
              "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
            },
            "execution": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "preferred": { "enum": ["native", "container", "remote"] },
                "supported": {
                  "type": "array",
                  "items": { "enum": ["native", "container", "remote"] }
                },
                "lifecycle": { "enum": ["persistent", "ephemeral"] },
                "backends": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "container": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["image"],
                      "properties": {
                        "image": { "type": "string" }
                      }
                    },
                    "remote": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["provider"],
                      "properties": {
                        "provider": { "type": "string" },
                        "target": { "type": "string" },
                        "cwd": { "type": "string" }
                      }
                    }
                  }
                },
                "env": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "required"],
                    "properties": {
                      "name": { "type": "string" },
                    "required": { "type": "boolean" },
                    "default": { "type": "string" },
                    "policy": { "type": "string" },
                    "source": { "type": "string" },
                    "allowed": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                  }
                }
              }
            },
            "extensions": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "command", "api_version"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["checker", "publisher"]
                  },
                  "command": { "type": "string" },
                  "api_version": { "type": "integer", "minimum": 1 },
                  "description": { "type": "string" },
                  "config": { "type": "object" }
                }
              }
            },
            "findings": {
              "type": "array",
              "items": { "$ref": "./shared.json#/$defs/finding" }
            }
          }
      }
    }
  }
}
