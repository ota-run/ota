{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ota.run/spec/json-schemas/workspace-doctor.json",
  "title": "ota workspace doctor --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "repos"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "repos": {
      "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "path", "contract_path", "required", "ok", "findings"],
          "properties": {
            "name": { "type": "string" },
            "path": { "type": "string" },
            "contract_path": { "type": "string" },
            "required": { "type": "boolean" },
            "ok": { "type": "boolean" },
            "execution": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "preferred": { "enum": ["native", "container", "remote"] },
                "supported": {
                  "type": "array",
                  "items": { "enum": ["native", "container", "remote"] }
                },
                "lifecycle": { "enum": ["persistent", "ephemeral"] },
                "backends": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "container": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["image"],
                      "properties": {
                        "image": { "type": "string" }
                      }
                    },
                    "remote": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["provider"],
                      "properties": {
                        "provider": { "type": "string" },
                        "target": { "type": "string" },
                        "cwd": { "type": "string" }
                      }
                    }
                  }
                }
              }
            },
            "extensions": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "command", "api_version"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["checker", "publisher"]
                  },
                  "command": { "type": "string" },
                  "api_version": { "type": "integer", "minimum": 1 },
                  "description": { "type": "string" },
                  "config": { "type": "object" }
                }
              }
            },
            "findings": {
              "type": "array",
              "items": { "$ref": "./shared.json#/$defs/finding" }
            }
          }
      }
    }
  }
}
