{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/assist-declare-readiness.json",
  "title": "ota assist declare-readiness --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "path",
        "mode",
        "operation",
        "subject",
        "inputs",
        "assumptions",
        "changes",
        "diff",
        "validation",
        "next"
      ],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "mode": { "enum": ["preview", "write"] },
        "operation": { "const": "declare-readiness" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "task": { "type": "string" },
            "service": { "type": "string" }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style"],
          "properties": {
            "endpoint": { "type": "string" },
            "style": {
              "enum": ["spring-http", "http", "tcp", "compose-health"]
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "before", "after"],
            "properties": {
              "path": { "type": "string" },
              "action": { "const": "set" },
              "before": {},
              "after": {}
            }
          }
        },
        "diff": { "type": "string" },
        "validation": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "operation", "why", "next"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "operation": { "const": "declare-readiness" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "task": { "type": "string" },
            "service": { "type": "string" }
          }
        },
        "why": { "type": "string" },
        "next": { "type": "string" }
      }
    }
  ]
}
