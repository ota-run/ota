{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/assist-bind-task.json",
  "title": "ota assist bind-task --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "path",
        "mode",
        "operation",
        "subject",
        "inputs",
        "assumptions",
        "changes",
        "diff",
        "validation",
        "next"
      ],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "mode": { "enum": ["preview", "write"] },
        "operation": { "const": "bind-task" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task", "target"],
          "properties": {
            "task": { "type": "string" },
            "target": { "type": "string" }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["to", "address_view", "activation"],
          "properties": {
            "to": { "type": "string" },
            "producer_member": { "type": "string" },
            "address_view": { "enum": ["topology", "host", "internal"] },
            "activation": {
              "enum": [
                "manual",
                "ensure_started",
                "restart_ready",
                "ensure_ready",
                "ensure_running"
              ]
            },
            "override_input": { "type": "string" }
          }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "before", "after"],
            "properties": {
              "path": { "type": "string" },
              "action": { "const": "set" },
              "before": {},
              "after": {}
            }
          }
        },
        "diff": { "type": "string" },
        "validation": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "operation", "subject", "why", "next"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "operation": { "const": "bind-task" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task", "target"],
          "properties": {
            "task": { "type": "string" },
            "target": { "type": "string" }
          }
        },
        "why": { "type": "string" },
        "next": { "type": "string" }
      }
    }
  ]
}
