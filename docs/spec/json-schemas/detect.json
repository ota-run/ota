{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/detect.json",
  "title": "ota detect --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "config", "inferred"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "written": { "type": "boolean" },
        "config": { "type": "object" },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existing_contract"],
          "properties": {
            "existing_contract": { "const": true },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "status", "detected"],
                "properties": {
                  "field": { "type": "string" },
                  "status": { "enum": ["add", "update"] },
                  "existing": { "type": "string" },
                  "detected": { "type": "string" }
                }
              }
            },
            "removals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "existing"],
                "properties": {
                  "field": { "type": "string" },
                  "existing": { "type": "string" }
                }
              }
            },
            "error": { "type": "string" }
          }
        },
        "inferred": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/inference" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "error"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "written": { "const": false },
        "error": { "type": "string" },
        "next": { "type": "string" }
      }
    }
  ]
}
