{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/detect.json",
  "title": "ota detect --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "config", "inferred"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "written": { "type": "boolean" },
        "config": { "type": "object" },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existing_contract"],
          "properties": {
            "existing_contract": { "const": true },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "status", "detected"],
                "properties": {
                  "field": { "type": "string" },
                  "status": { "enum": ["add", "update"] },
                  "existing": { "type": "string" },
                  "detected": { "type": "string" },
                  "owner_kind": { "enum": ["detected", "manual", "merged", "policy"] },
                  "ownership": { "enum": ["repo_contract", "repo_signals"] },
                  "provenance": { "type": "string" },
                  "provenance_key": { "enum": ["repo_signals"] },
                  "source": { "type": "string" },
                  "confidence": { "enum": ["low", "medium", "high"] }
                }
              }
            },
            "removals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "existing"],
                "properties": {
                  "field": { "type": "string" },
                  "existing": { "type": "string" },
                  "owner_kind": { "enum": ["manual", "merged", "policy"] },
                  "ownership": { "enum": ["repo_contract"] },
                  "provenance": { "type": "string" },
                  "provenance_key": { "enum": ["repo_signals"] }
                }
              }
            },
            "error": { "type": "string" }
          }
        },
        "inferred": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/inference" }
        },
        "toolchain_opportunities": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/toolchainOpportunity" }
        },
        "candidate_path": {
          "type": "string"
        },
        "candidate": {
          "$ref": "./contract-candidate.json"
        }
      },
      "allOf": [
        {
          "if": { "required": ["candidate"] },
          "then": {
            "required": ["candidate_path"],
            "properties": { "written": { "const": false } }
          }
        },
        {
          "if": { "required": ["candidate_path"] },
          "then": {
            "required": ["candidate"],
            "properties": { "written": { "const": false } }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "error"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "written": { "const": false },
        "error": { "type": "string" },
        "next": { "type": "string" }
      }
    }
  ]
}
