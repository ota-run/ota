{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/detect.json",
  "title": "ota detect --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "config", "inferred"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "written": { "type": "boolean" },
        "config": { "type": "object" },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existing_contract"],
          "properties": {
            "existing_contract": { "const": true },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "status", "detected"],
                "properties": {
                  "field": { "type": "string" },
                  "status": { "enum": ["add", "update"] },
                  "existing": { "type": "string" },
                  "detected": { "type": "string" },
                  "owner_kind": { "enum": ["detected", "manual", "merged", "policy"] },
                  "ownership": { "enum": ["repo_contract", "repo_signals"] },
                  "provenance": { "type": "string" },
                  "provenance_key": { "enum": ["repo_signals"] },
                  "source": { "type": "string" },
                  "confidence": { "enum": ["low", "medium", "high"] }
                }
              }
            },
            "removals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "existing"],
                "properties": {
                  "field": { "type": "string" },
                  "existing": { "type": "string" },
                  "owner_kind": { "enum": ["manual", "merged", "policy"] },
                  "ownership": { "enum": ["repo_contract"] },
                  "provenance": { "type": "string" },
                  "provenance_key": { "enum": ["repo_signals"] }
                }
              }
            },
            "error": { "type": "string" }
          }
        },
        "inferred": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/inference" }
        },
        "toolchain_opportunities": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/toolchainOpportunity" }
        },
        "candidate_path": {
          "type": "string"
        },
        "candidate_published": { "const": true },
        "candidate_publication": { "const": "durable" },
        "candidate": {
          "$ref": "./contract-candidate.json"
        }
      },
      "allOf": [
        {
          "if": { "required": ["candidate"] },
          "then": {
            "required": ["candidate_path", "candidate_published", "candidate_publication"],
            "properties": { "written": { "const": false } }
          }
        },
        {
          "if": { "required": ["candidate_path"] },
          "then": {
            "required": ["candidate"],
            "properties": { "written": { "const": false } }
          }
        },
        {
          "if": { "required": ["candidate_published"] },
          "then": {
            "required": ["candidate", "candidate_path", "candidate_publication"],
            "properties": { "written": { "const": false } }
          }
        },
        {
          "if": { "required": ["candidate_publication"] },
          "then": {
            "required": ["candidate", "candidate_path", "candidate_published"],
            "properties": { "written": { "const": false } }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "code", "removed_flags", "replacement", "error"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "written": { "const": false },
        "code": { "const": "detect_legacy_mutation_removed" },
        "removed_flags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["--merge", "--apply", "--apply-all", "--rewrite", "--yes"] }
        },
        "replacement": { "const": "ota detect --candidate-out .ota/candidates/detect.json" },
        "error": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "code", "error", "next"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "written": { "const": true },
        "code": { "const": "candidate_write_durability_uncertain" },
        "error": { "type": "string", "minLength": 1 },
        "next": { "const": "inspect ota.yaml before retrying" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "path",
        "written",
        "candidate_path",
        "candidate_published",
        "candidate_publication",
        "error",
        "next"
      ],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "written": { "const": false },
        "candidate_path": { "type": "string", "minLength": 1 },
        "candidate_published": { "type": "boolean" },
        "candidate_publication": { "enum": ["not_published", "durability_uncertain"] },
        "error": { "type": "string", "minLength": 1 },
        "next": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "candidate_publication": { "const": "not_published" } } },
          "then": { "properties": { "candidate_published": { "const": false } } }
        },
        {
          "if": { "properties": { "candidate_publication": { "const": "durability_uncertain" } } },
          "then": { "properties": { "candidate_published": { "const": true } } }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "error"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "written": { "const": false },
        "error": { "type": "string" },
        "next": { "type": "string" }
      }
    }
  ]
}
