            "backend": { "type": "string" },
            "context": { "type": "string" },
            "lifecycle": { "type": "string" },
            "image": { "type": "string" },
            "container_memory_bytes": { "type": "integer", "minimum": 1 },
            "target": { "type": "string" },
            "task": { "type": "string" }
