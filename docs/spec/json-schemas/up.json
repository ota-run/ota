{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/up.json",
  "title": "ota up --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "status", "phase", "findings"],
      "properties": {
        "ok": { "type": "boolean" },
        "path": { "type": "string" },
        "status": { "type": "string" },
        "phase": {
          "enum": ["preconditions", "services", "setup", "post-setup diagnosis"]
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/finding" }
        },
        "service": { "type": "string" },
        "task": { "type": "string" },
        "exit_code": { "type": "integer" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["member", "ok", "status", "phase", "findings"],
            "properties": {
              "member": { "type": "string" },
              "ok": { "type": "boolean" },
              "status": { "type": "string" },
              "phase": { "type": "string" },
              "findings": {
                "type": "array",
                "items": { "$ref": "./shared.json#/$defs/finding" }
              },
              "service": { "type": "string" },
              "task": { "type": "string" },
              "exit_code": { "type": "integer" }
            }
          }
        }
      }
    },
    {
      "$ref": "./validate.json#/oneOf/1"
    }
  ]
}
