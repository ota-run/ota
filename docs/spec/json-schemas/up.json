                "required": ["member", "ok", "dry_run", "status", "phase", "summary", "contract_identity", "execution", "plan"],
                "properties": {
                  "member": { "type": "string" },
                  "ok": { "type": "boolean" },
                  "dry_run": { "const": true },
                  "status": { "type": "string" },
                  "phase": { "const": "preview" },
                  "summary": { "$ref": "./doctor.json#/properties/summary" },
                  "contract_identity": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["version", "project", "counts"],
                    "properties": {
                      "version": { "type": "integer", "minimum": 1 },
                      "project": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name"],
                        "properties": {
                          "name": { "type": "string" },
                          "type": { "type": "string" }
                        }
                      },
                      "metadata": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "owner": { "type": "string" },
                          "team": { "type": "string" },
                          "repo_class": { "type": "string" }
                        }
                      },
                      "execution": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "preferred": { "type": "string" },
                          "lifecycle": { "type": "string" },
                          "supported": {
                            "type": "array",
                            "items": { "type": "string" }
                          },
                          "image": { "type": "string" }
                        }
                      },
                      "counts": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["runtimes", "tools", "env", "services", "checks", "tasks"],
                        "properties": {
                          "runtimes": { "type": "integer", "minimum": 0 },
                          "tools": { "type": "integer", "minimum": 0 },
                          "env": { "type": "integer", "minimum": 0 },
                          "services": { "type": "integer", "minimum": 0 },
                          "checks": { "type": "integer", "minimum": 0 },
                          "tasks": { "type": "integer", "minimum": 0 },
                          "repos": { "type": "integer", "minimum": 0 },
                          "policies": { "type": "integer", "minimum": 0 }
                        }
                      }
                    }
                  },
                  "execution": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["backend"],
                    "properties": {
                      "backend": { "type": "string" },
                      "lifecycle": { "type": "string" },
                      "image": { "type": "string" },
                      "target": { "type": "string" },
                      "task": { "type": "string" }
                    }
                  },
                  "plan": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["actions"],
                    "properties": {
                      "actions": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "skipped": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    }
                  },
                  "blockers": {
                    "type": "array",
                    "items": { "$ref": "./shared.json#/$defs/finding" }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "$ref": "./validate.json#/oneOf/1"
    }
  ]
}
