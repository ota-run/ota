      "additionalProperties": false,
      "required": ["ok", "path", "dry_run", "status", "preview_status", "phase", "summary", "contract_identity", "execution", "plan"],
      "properties": {
        "ok": { "type": "boolean" },
        "path": { "type": "string" },
        "dry_run": { "const": true },
        "status": { "type": "string" },
        "preview_status": {
          "enum": ["RUNNABLE", "RUNNABLE WITH WARNINGS", "BLOCKED"]
        },
        "phase": { "const": "preview" },
        "summary": { "$ref": "./doctor.json#/properties/summary" },
        "contract_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "project", "counts"],
          "properties": {
            "version": { "type": "integer", "minimum": 1 },
            "project": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" }
              }
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "owner": { "type": "string" },
                "team": { "type": "string" },
                "repo_class": { "type": "string" }
              }
            },
            "execution": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
