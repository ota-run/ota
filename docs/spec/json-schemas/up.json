                      "env": { "type": "integer", "minimum": 0 },
                      "services": { "type": "integer", "minimum": 0 },
                      "checks": { "type": "integer", "minimum": 0 },
                      "tasks": { "type": "integer", "minimum": 0 },
                      "repos": { "type": "integer", "minimum": 0 },
                      "policies": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              },
              "execution": {
                "type": "object",
                "additionalProperties": false,
