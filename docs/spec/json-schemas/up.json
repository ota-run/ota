                "execution_attempted": { "type": "boolean" },
                "refusal_occurred": { "type": "boolean" },
                "refusal_reason_family": { "type": "string" },
                "not_run_reason": { "type": "string" },
                "crossing_record_state": { "type": "string" },
                "receipt_present": { "type": "boolean" },
                "proof_present": { "type": "boolean" },
                "receipt_status": { "type": "string" }
              }
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/finding" }
        },
        "stderr": { "type": "string" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["member", "ok", "dry_run", "status", "preview_status", "phase", "summary", "contract_identity", "execution", "plan"],
