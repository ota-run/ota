{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/agents.json",
  "title": "ota agents --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "output", "written", "mode", "content"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "output": { "type": "string" },
        "written": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["preview", "already_in_sync", "appended", "wrote"]
        },
        "content": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "error"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "written": { "const": false },
        "error": { "type": "string" },
        "next": { "type": "string" }
      }
    }
  ]
}
