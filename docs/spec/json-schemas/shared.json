{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/shared.json",
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "summary", "why", "next"],
      "properties": {
        "severity": { "enum": ["error", "warn", "info"] },
        "summary": { "type": "string" },
        "why": { "type": "string" },
        "next": { "type": "string" },
        "ownership": {
          "enum": [
            "repo_contract",
            "host",
            "service",
            "workspace_acquisition",
            "org_policy",
            "remote_backend"
          ]
        },
        "provenance": { "type": "string" },
        "policy_outcome": {
          "enum": [
            "satisfied",
            "installable",
            "blocked_by_policy",
            "blocked_by_source_unavailable",
            "blocked_by_integrity_policy",
            "unsupported_resolution_path"
          ]
        },
        "policy_reason": { "type": "string" },
        "policy_source": { "enum": ["repo", "local", "org", "dashboard"] },
        "install_scope": { "enum": ["host", "repo_local", "container", "remote"] },
        "mutation_allowed": { "type": "boolean" }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "source", "confidence"],
      "properties": {
        "field": { "type": "string" },
        "value": { "type": "string" },
        "source": { "type": "string" },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    }
  }
}
