{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/shared.json",
  "$defs": {
    "artifactRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "stage_family"],
      "properties": {
        "role": {
          "enum": ["follow_up", "inspect", "keep"]
        },
        "kind": { "type": "string" },
        "stage_family": {
          "enum": ["prepare", "setup", "verify", "proof", "receipt"]
        },
        "command": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "owner", "severity", "summary", "why", "next", "evidence"],
      "properties": {
        "code": { "type": "string" },
        "category": {
          "enum": [
            "contract",
            "execution",
            "provisioning",
            "policy",
            "service",
            "environment",
            "remote",
            "workspace"
          ]
        },
        "owner": {
          "enum": [
            "repo_contract",
            "host",
            "container_target",
            "service",
            "workspace_acquisition",
            "org_policy",
            "remote_backend",
            "agent_safety"
          ]
        },
        "severity": { "enum": ["error", "warn", "info"] },
        "summary": { "type": "string" },
        "why": { "type": "string" },
        "next": { "type": "string" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed", "expected", "source", "checked_at", "command", "path"],
          "properties": {
            "observed": { "type": "string" },
            "expected": { "type": "string" },
            "source": { "type": "string" },
            "checked_at": { "type": "string" },
            "command": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "ownership": {
          "enum": [
            "repo_contract",
            "host",
            "service",
            "workspace_acquisition",
            "org_policy",
            "remote_backend"
          ]
        },
        "provenance": { "type": "string" },
        "provenance_key": {
          "enum": [
            "org_policy",
            "repo_signals",
            "repo_contract"
          ]
        },
        "policy_outcome": {
          "enum": [
            "satisfied",
            "installable",
            "policy_surface_available",
            "blocked_by_policy",
            "blocked_by_source_unavailable",
            "blocked_by_integrity_policy",
            "unsupported_resolution_path"
          ]
        },
        "policy_reason": { "type": "string" },
        "policy_source": { "enum": ["repo", "local", "org", "dashboard"] },
        "install_scope": { "enum": ["host", "repo_local", "container", "remote"] },
        "mutation_allowed": { "type": "boolean" },
        "toolchain_opportunity": { "$ref": "#/$defs/toolchainOpportunity" }
      }
    },
    "toolchainOpportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystem",
        "fallback_runtime",
        "fallback_tools",
        "candidate_providers",
        "shipped",
        "agent_note"
      ],
      "properties": {
        "ecosystem": { "type": "string" },
        "fallback_runtime": { "type": "string" },
        "fallback_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "candidate_providers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "shipped": { "type": "boolean" },
        "agent_note": { "type": "string" }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "source", "confidence"],
      "properties": {
        "field": { "type": "string" },
        "type": {
          "enum": ["project", "runtime", "tool", "env", "service", "check", "task", "agent", "field"]
        },
        "value": { "type": "string" },
        "source": { "type": "string" },
        "signal": {
          "enum": ["config", "script", "lockfile", "file", "template", "convention"]
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "agent_safe": { "enum": ["yes", "no", "unknown"] },
        "agent_signal": { "enum": ["verification_candidate", "bootstrap_candidate"] }
      }
    },
    "contractFieldProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "provenance", "provenance_key"],
      "properties": {
        "field": { "type": "string" },
        "provenance": {
          "enum": [
            "detector-inferred",
            "template-derived",
            "workspace-derived",
            "workspace-declared"
          ]
        },
        "provenance_key": {
          "enum": [
            "repo_signals",
            "template_derived",
            "workspace_scaffold",
            "workspace_contract"
          ]
        },
        "source": { "type": "string" },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    },
    "provisioningPlanEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "requested_version"],
      "properties": {
        "kind": { "enum": ["runtime", "tool"] },
        "name": { "type": "string" },
        "requested_version": { "type": "string" },
        "normalized_requirement": { "type": ["string", "null"] },
        "resolved_version": { "type": ["string", "null"] },
        "package": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "source_config": { "type": ["object", "null"] },
        "approved_version": { "type": ["string", "null"] },
        "policy_match": { "type": ["string", "null"] },
        "blocked_reason": { "type": ["string", "null"] }
      }
    },
    "provisioningAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_kind", "name", "requested_version", "source"],
      "properties": {
        "kind": { "enum": ["select_source", "install", "verify"] },
        "target_kind": { "enum": ["runtime", "tool"] },
        "name": { "type": "string" },
        "requested_version": { "type": "string" },
        "normalized_requirement": { "type": ["string", "null"] },
        "resolved_version": { "type": ["string", "null"] },
        "package": { "type": ["string", "null"] },
        "source": { "type": "string" },
        "source_config": { "type": ["object", "null"] },
        "approved_version": { "type": ["string", "null"] },
        "policy_match": { "type": ["string", "null"] }
      }
    },
    "provisioningPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "blocked", "actions"],
      "properties": {
        "allowed": {
          "type": "array",
          "items": { "$ref": "#/$defs/provisioningPlanEntry" }
        },
        "blocked": {
          "type": "array",
          "items": { "$ref": "#/$defs/provisioningPlanEntry" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/provisioningAction" }
        }
      }
    },
    "provisioningBackendRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/provisioningAction" }
        }
      }
    },
    "adapterBootstrapPlanEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" },
        "approved_version": { "type": "string" },
        "blocked_reason": { "type": "string" }
      }
    },
    "adapterBootstrapPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "blocked"],
      "properties": {
        "allowed": {
          "type": "array",
          "items": { "$ref": "#/$defs/adapterBootstrapPlanEntry" }
        },
        "blocked": {
          "type": "array",
          "items": { "$ref": "#/$defs/adapterBootstrapPlanEntry" }
        }
      }
    },
    "adapterBootstrapDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "request"],
      "properties": {
        "plan": { "$ref": "#/$defs/adapterBootstrapPlan" },
        "request": { "$ref": "#/$defs/provisioningBackendRequest" }
      }
    },
    "resolvedTaskRuntimeBind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "port"],
      "properties": {
        "address": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "resolvedTaskRuntimeHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "port"],
      "properties": {
        "address": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "url": { "type": "string" }
      }
    },
    "resolvedTaskRuntimeResolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "$ref": "#/$defs/resolvedTaskRuntimeHost" }
      }
    },
    "resolvedTaskRuntimeListener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "bind"],
      "properties": {
        "protocol": { "enum": ["http", "https", "tcp"] },
        "bind": { "$ref": "#/$defs/resolvedTaskRuntimeBind" },
        "resolved": { "$ref": "#/$defs/resolvedTaskRuntimeResolution" }
      }
    },
    "resolvedTaskRuntimeEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listener", "protocol", "bind", "host", "primary"],
      "properties": {
        "listener": { "type": "string" },
        "protocol": { "enum": ["http", "https", "tcp"] },
        "bind": { "$ref": "#/$defs/resolvedTaskRuntimeBind" },
        "host": { "$ref": "#/$defs/resolvedTaskRuntimeHost" },
        "primary": { "type": "boolean" }
      }
    },
    "resolvedTaskRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "listeners"],
      "properties": {
        "kind": { "const": "service" },
        "listeners": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/resolvedTaskRuntimeListener"
          }
        },
        "primary_listener": { "type": "string" },
        "primary_endpoint": { "$ref": "#/$defs/resolvedTaskRuntimeEndpoint" },
        "exposed_endpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/resolvedTaskRuntimeEndpoint" }
        }
      }
    },
    "serviceTermination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cause", "after_readiness", "target", "container"],
      "properties": {
        "kind": { "const": "service_stopped" },
        "cause": {
          "enum": [
            "oom_killed",
            "interrupted",
            "exited_non_zero",
            "exited",
            "unknown"
          ]
        },
        "after_readiness": { "type": "boolean" },
        "target": { "const": "container" },
        "container": { "type": "string" },
        "exit_code": { "type": "integer" }
      }
    }
  }
}
