{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/shared.json",
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "owner", "severity", "summary", "why", "next", "evidence"],
      "properties": {
        "code": { "type": "string" },
        "category": {
          "enum": [
            "contract",
            "execution",
            "policy",
            "service",
            "environment",
            "remote",
            "workspace"
          ]
        },
        "owner": {
          "enum": [
            "repo_contract",
            "host",
            "service",
            "workspace_acquisition",
            "org_policy",
            "remote_backend",
            "agent_safety"
          ]
        },
        "severity": { "enum": ["error", "warn", "info"] },
        "summary": { "type": "string" },
        "why": { "type": "string" },
        "next": { "type": "string" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed", "expected", "source", "checked_at", "command", "path"],
          "properties": {
            "observed": { "type": "string" },
            "expected": { "type": "string" },
            "source": { "type": "string" },
            "checked_at": { "type": "string" },
            "command": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "ownership": {
          "enum": [
            "repo_contract",
            "host",
            "service",
            "workspace_acquisition",
            "org_policy",
            "remote_backend"
          ]
        },
        "provenance": { "type": "string" },
        "provenance_key": {
          "enum": [
            "org_policy",
            "repo_signals"
          ]
        },
        "policy_outcome": {
          "enum": [
            "satisfied",
            "installable",
            "blocked_by_policy",
            "blocked_by_source_unavailable",
            "blocked_by_integrity_policy",
            "unsupported_resolution_path"
          ]
        },
        "policy_reason": { "type": "string" },
        "policy_source": { "enum": ["repo", "local", "org", "dashboard"] },
        "install_scope": { "enum": ["host", "repo_local", "container", "remote"] },
        "mutation_allowed": { "type": "boolean" }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "source", "confidence"],
      "properties": {
        "field": { "type": "string" },
        "value": { "type": "string" },
        "source": { "type": "string" },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    },
    "contractFieldProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "provenance", "provenance_key"],
      "properties": {
        "field": { "type": "string" },
        "provenance": {
          "enum": [
            "detector-inferred",
            "template-derived",
            "workspace-derived",
            "workspace-declared"
          ]
        },
        "provenance_key": {
          "enum": [
            "repo_signals",
            "template_derived",
            "workspace_scaffold",
            "workspace_contract"
          ]
        },
        "source": { "type": "string" },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    }
  }
}
