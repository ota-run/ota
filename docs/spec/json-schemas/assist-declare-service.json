{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/assist-declare-service.json",
  "title": "ota assist declare-service --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "path",
        "mode",
        "operation",
        "subject",
        "inputs",
        "assumptions",
        "changes",
        "diff",
        "validation",
        "next"
      ],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "mode": { "enum": ["preview", "write"] },
        "operation": { "const": "declare-service" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service"],
          "properties": {
            "service": { "type": "string" }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "manager": { "enum": ["compose", "host"] },
            "manager_name": { "type": "string" },
            "compose_file": { "type": "string" },
            "compose_service": { "type": "string" },
            "endpoint": { "type": "string" },
            "endpoint_context": { "type": "string" },
            "address": { "type": "string" },
            "port": { "type": "string" },
            "required": { "enum": ["true", "false"] },
            "style": { "enum": ["spring-http", "http", "tcp", "compose-health"] },
            "producer": { "type": "string" },
            "producer_repo": { "type": "string" }
          }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "before", "after"],
            "properties": {
              "path": { "type": "string" },
              "action": { "const": "set" },
              "before": {},
              "after": {}
            }
          }
        },
        "diff": { "type": "string" },
        "validation": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "operation", "subject", "why", "next"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "operation": { "const": "declare-service" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service"],
          "properties": {
            "service": { "type": "string" }
          }
        },
        "why": { "type": "string" },
        "next": { "type": "string" }
      }
    }
  ]
}
