{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ota.run/spec/json-schemas/workspace-tasks.json",
  "title": "ota workspace tasks --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "repos"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "contract_path",
          "required",
          "acquired",
          "depends_on",
          "tasks"
        ],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "contract_path": { "type": "string" },
          "required": { "type": "boolean" },
          "acquired": { "type": "boolean" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "depends_on"],
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string" },
                "run": { "type": "string" },
                "script": { "type": "string" },
                "depends_on": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
