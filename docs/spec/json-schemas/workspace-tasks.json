{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/workspace-tasks.json",
  "title": "ota workspace tasks --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "summary", "repos"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_count", "acquired_count", "task_count"],
      "properties": {
        "repo_count": { "type": "integer", "minimum": 0 },
        "acquired_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "contract_path",
          "required",
          "acquired",
          "depends_on",
          "tasks"
        ],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "contract_path": { "type": "string" },
          "required": { "type": "boolean" },
          "acquired": { "type": "boolean" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "depends_on"],
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string" },
                "description": { "type": "string" },
                "run": { "type": "string" },
                "script": { "type": "string" },
                "depends_on": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "requires_services": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "after_success": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after_failure": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after_always": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
