{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/workspace-tasks.json",
  "title": "ota workspace tasks --json",
  "$defs": {
    "taskLaunchVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target"],
      "properties": {
        "kind": { "enum": ["named"] },
        "source": { "type": "string" },
        "target": { "type": "string" }
      }
    },
    "taskLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["command", "container"] },
        "exe": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "image": { "type": "string" },
        "engine": { "type": "string" },
        "name": { "type": "string" },
        "remove": { "type": "boolean" },
        "volumes": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskLaunchVolume" }
        }
      }
    },
    "taskAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "copy_if_missing" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "vars"],
          "properties": {
            "kind": { "const": "ensure_env_file" },
            "path": { "type": "string" },
            "template": { "type": "string" },
            "vars": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": { "type": "string" },
                  "random": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "bytes": { "type": "integer", "minimum": 1 },
                      "encoding": { "enum": ["hex", "base64"] }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "ensure_file" },
            "path": { "type": "string" },
            "template": { "type": "string" },
            "value": { "type": "string" },
            "random": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bytes": { "type": "integer", "minimum": 1 },
                "encoding": { "enum": ["hex", "base64"] }
              }
            }
          }
        }
      ]
    },
    "taskEffects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "network": { "type": "boolean" },
        "external_state": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "summary", "repos"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_count", "acquired_count", "task_count"],
      "properties": {
        "repo_count": { "type": "integer", "minimum": 0 },
        "acquired_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "contract_path",
          "required",
          "acquired",
          "depends_on",
          "tasks"
        ],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "contract_path": { "type": "string" },
          "required": { "type": "boolean" },
          "acquired": { "type": "boolean" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "depends_on"],
              "properties": {
                "name": { "type": "string" },
                "kind": { "enum": ["run", "script", "command", "container", "copy_if_missing", "ensure_env_file", "ensure_file"] },
                "description": { "type": "string" },
                "run": { "type": "string" },
                "script": { "type": "string" },
                "launch": { "$ref": "#/$defs/taskLaunch" },
                "action": { "$ref": "#/$defs/taskAction" },
                "effects": { "$ref": "#/$defs/taskEffects" },
                "depends_on": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "requires_services": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "after_success": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after_failure": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after_always": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
