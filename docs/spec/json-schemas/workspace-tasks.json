{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/workspace-tasks.json",
  "title": "ota workspace tasks --json",
  "$defs": {
    "taskLaunchVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target"],
      "properties": {
        "kind": { "enum": ["named"] },
        "source": { "type": "string" },
        "target": { "type": "string" }
      }
    },
    "taskLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["command", "container"] },
        "exe": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "image": { "type": "string" },
        "engine": { "type": "string" },
        "name": { "type": "string" },
        "remove": { "type": "boolean" },
        "volumes": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskLaunchVolume" }
        }
      }
    },
    "taskCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exe"],
      "properties": {
        "exe": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cwd": { "type": "string" },
        "interaction": { "enum": ["auto", "forbidden", "required"], "default": "auto" }
      }
    },
    "taskAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "copy_if_missing" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_env_file" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_file" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_directory" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "ensure_git_checkout" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "ensure_git_template" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "checkouts"],
          "properties": {
            "kind": { "const": "ensure_git_checkouts" },
            "checkouts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "source"],
                "properties": {
                  "path": { "type": "string" },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["git"],
                    "properties": {
                      "git": { "type": "string" },
                      "ref": { "type": "string" }
                    }
                  },
                  "remotes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name", "git"],
                      "properties": {
                        "name": { "type": "string" },
                        "git": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "ensure_container_network" },
            "from": { "enum": ["docker"] },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to", "context"],
          "properties": {
            "kind": { "const": "build_container_image" },
            "from": { "type": "string" },
            "to": { "type": "string" },
            "context": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "reset_compose_service_volume" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "ensure_virtualenv" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "ensure_bundle" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from"],
          "properties": {
            "kind": { "const": "database_schema_mutation" },
            "from": { "type": "string" }
          }
        }
      ]
    },
    "taskPrepare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["sequence", "dependency_hydration", "tool_bootstrap"] },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskPrepare" }
        },
        "tool": { "enum": ["uv"] },
        "medium": { "enum": ["container_images", "package_dependencies"] },
        "source_kind": {
          "enum": [
            "pip",
            "docker_compose",
            "node_package_manager",
            "bundler",
            "uv",
            "poetry",
            "go_modules",
            "maven",
            "gradle",
            "cargo",
            "dotnet_restore"
          ]
        },
        "cwd": { "type": "string" },
        "file": { "type": "string" },
        "manager": {
          "enum": [
            "npm",
            "pnpm",
            "yarn",
            "bun",
            "bundle",
            "uv",
            "poetry",
            "mvn",
            "./mvnw",
            "gradle",
            "./gradlew",
            "cargo",
            "dotnet"
          ]
        },
        "filter": { "type": "string" },
        "mode": {
          "enum": [
            "install",
            "ci",
            "sync",
            "pip_requirements",
            "pip_local_project",
            "download",
            "uv",
            "resolve",
            "go-offline",
            "dependencies",
            "fetch",
            "restore"
          ]
        },
        "group_mode": { "enum": ["with", "only"] },
        "groups": {
          "type": "array",
          "items": { "type": "string" }
        },
        "declared_hydration_provenance": {
          "$ref": "#/$defs/taskHydrationProvenance"
        },
        "resolved_hydration_provenance": {
          "$ref": "#/$defs/taskHydrationProvenance"
        },
        "declared_uv_local_project": {
          "$ref": "#/$defs/taskUvLocalProject"
        },
        "resolved_uv_local_project": {
          "$ref": "#/$defs/taskUvLocalProject"
        },
        "frozen_lockfile": { "type": "boolean" },
        "inline_builds": { "type": "boolean" },
        "force": { "type": "boolean" },
        "no_root": { "type": "boolean" },
        "targets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "browsers": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskHydrationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_posture"],
      "properties": {
        "source_posture": {
          "enum": ["ambient_default", "config_file", "explicit_sources"]
        },
        "config_file": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "offline": { "type": "boolean" },
        "source_identities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        },
        "resolution": { "enum": ["resolved", "unavailable"] },
        "resolution_error": { "type": "string" }
      }
    },
    "taskUvLocalProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "editable": { "type": "boolean" },
        "extras": { "type": "array", "items": { "type": "string" } },
        "groups": { "type": "array", "items": { "type": "string" } },
        "lockfile": { "type": "string" },
        "manifest_path": { "type": "string" },
        "manifest_identity": { "type": "string" },
        "source_identity": { "type": "string" },
        "source_identity_error": { "type": "string" },
        "lockfile_identity": { "type": "string" },
        "resolution": { "enum": ["resolved", "unavailable"] },
        "resolution_error": { "type": "string" }
      }
    },
    "taskAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskEffects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "workspace_writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "network": { "type": "boolean" },
        "network_kind": {
          "enum": ["broad", "dependency_hydration", "container_image_hydration", "service_readiness", "integration_test", "tool_bootstrap"]
        },
        "external_state": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "summary", "repos"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_count", "acquired_count", "task_count"],
      "properties": {
        "repo_count": { "type": "integer", "minimum": 0 },
        "acquired_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "contract_path",
          "required",
          "acquired",
          "depends_on",
          "tasks"
        ],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "contract_path": { "type": "string" },
          "required": { "type": "boolean" },
          "acquired": { "type": "boolean" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "depends_on"],
              "properties": {
                "name": { "type": "string" },
                "kind": { "enum": ["run", "script", "command", "container", "copy_if_missing", "ensure_env_file", "ensure_file", "ensure_directory", "ensure_virtualenv", "ensure_git_checkout", "ensure_git_template", "ensure_git_checkouts", "ensure_container_network", "build_container_image", "reset_compose_service_volume", "ensure_bundle", "database_schema_mutation", "sequence", "dependency_hydration", "tool_bootstrap", "aggregate"] },
                "description": { "type": "string" },
                "run": { "type": "string" },
                "script": { "type": "string" },
                "command": { "$ref": "#/$defs/taskCommand" },
                "launch": { "$ref": "#/$defs/taskLaunch" },
                "action": { "$ref": "#/$defs/taskAction" },
                "prepare": { "$ref": "#/$defs/taskPrepare" },
                "aggregate": { "$ref": "#/$defs/taskAggregate" },
                "effects": { "$ref": "#/$defs/taskEffects" },
                "depends_on": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "requires_services": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "requires_artifacts": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "after_success": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after_failure": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after_always": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
