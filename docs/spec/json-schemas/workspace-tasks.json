{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/workspace-tasks.json",
  "title": "ota workspace tasks --json",
  "$defs": {
    "taskLaunchVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target"],
      "properties": {
        "kind": { "enum": ["named"] },
        "source": { "type": "string" },
        "target": { "type": "string" }
      }
    },
    "taskLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["command", "container"] },
        "exe": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "image": { "type": "string" },
        "engine": { "type": "string" },
        "name": { "type": "string" },
        "remove": { "type": "boolean" },
        "volumes": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskLaunchVolume" }
        }
      }
    },
    "taskCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exe"],
      "properties": {
        "exe": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "copy_if_missing" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_env_file" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_file" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_directory" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "ensure_bundle" }
          }
        }
      ]
    },
    "taskPrepare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["sequence", "dependency_hydration"] },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskPrepare" }
        },
        "medium": { "enum": ["container_images", "package_dependencies"] },
        "source_kind": {
          "enum": [
            "docker_compose",
            "node_package_manager",
            "bundler",
            "uv",
            "poetry",
            "go_modules"
          ]
        },
        "cwd": { "type": "string" },
        "file": { "type": "string" },
        "manager": { "enum": ["npm", "pnpm", "yarn", "bundle", "uv", "poetry"] },
        "mode": { "enum": ["install", "ci", "sync", "download"] },
        "group_mode": { "enum": ["with", "only"] },
        "groups": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frozen_lockfile": { "type": "boolean" },
        "no_root": { "type": "boolean" },
        "targets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskEffects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "network": { "type": "boolean" },
        "network_kind": {
          "enum": ["broad", "dependency_hydration"]
        },
        "external_state": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "summary", "repos"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_count", "acquired_count", "task_count"],
      "properties": {
        "repo_count": { "type": "integer", "minimum": 0 },
        "acquired_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "contract_path",
          "required",
          "acquired",
          "depends_on",
          "tasks"
        ],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "contract_path": { "type": "string" },
          "required": { "type": "boolean" },
          "acquired": { "type": "boolean" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "depends_on"],
              "properties": {
                "name": { "type": "string" },
                "kind": { "enum": ["run", "script", "command", "container", "copy_if_missing", "ensure_env_file", "ensure_file", "ensure_directory", "ensure_bundle", "sequence", "dependency_hydration", "aggregate"] },
                "description": { "type": "string" },
                "run": { "type": "string" },
                "script": { "type": "string" },
                "command": { "$ref": "#/$defs/taskCommand" },
                "launch": { "$ref": "#/$defs/taskLaunch" },
                "action": { "$ref": "#/$defs/taskAction" },
                "prepare": { "$ref": "#/$defs/taskPrepare" },
                "aggregate": { "$ref": "#/$defs/taskAggregate" },
                "effects": { "$ref": "#/$defs/taskEffects" },
                "depends_on": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "requires_services": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "after_success": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after_failure": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "after_always": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
