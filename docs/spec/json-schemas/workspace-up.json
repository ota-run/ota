{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/workspace-up.json",
  "title": "ota workspace up --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "summary", "repos"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_count", "warn_count", "info_count", "step_count"],
      "properties": {
        "error_count": { "type": "integer", "minimum": 0 },
        "warn_count": { "type": "integer", "minimum": 0 },
        "info_count": { "type": "integer", "minimum": 0 },
        "step_count": { "type": "integer", "minimum": 0 }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "contract_path",
          "required",
          "ok",
          "status",
          "phase",
          "findings"
        ],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "contract_path": { "type": "string" },
          "required": { "type": "boolean" },
          "ok": { "type": "boolean" },
          "status": { "type": "string" },
          "phase": { "type": "string" },
          "findings": {
            "type": "array",
            "items": { "$ref": "./shared.json#/$defs/finding" }
          },
          "service": { "type": "string" },
          "task": { "type": "string" },
          "exit_code": { "type": "integer" },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" }
        }
      }
    }
  }
}
