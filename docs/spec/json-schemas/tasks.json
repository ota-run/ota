{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/tasks.json",
  "title": "ota tasks --json",
  "$defs": {
    "workflowSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "intent": { "type": "string" },
        "description": { "type": "string" },
        "notes": { "type": "string" },
        "prepare_task": { "type": "string" },
        "setup_task": { "type": "string" },
        "run_task": { "type": "string" },
        "run_task_launch": { "$ref": "#/$defs/taskLaunch" },
        "required_services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_probes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_probes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exposes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expose_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskLaunchVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target"],
      "properties": {
        "kind": { "enum": ["named"] },
        "source": { "type": "string" },
        "target": { "type": "string" }
      }
    },
    "taskLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["command", "container"] },
        "exe": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "image": { "type": "string" },
        "engine": { "type": "string" },
        "name": { "type": "string" },
        "remove": { "type": "boolean" },
        "volumes": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskLaunchVolume" }
        }
      }
    },
    "taskCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exe"],
      "properties": {
        "exe": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskComposeAdapterInputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "project_name": { "type": "string" }
      }
    },
    "taskAdapterInputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compose": { "$ref": "#/$defs/taskComposeAdapterInputs" }
      }
    },
    "taskAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "copy_if_missing" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_env_file" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_file" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_directory" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "ensure_bundle" }
          }
        }
      ]
    },
    "taskPrepare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["sequence", "dependency_hydration"] },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskPrepare" }
        },
        "medium": { "enum": ["container_images", "package_dependencies"] },
        "source_kind": {
          "enum": [
            "docker_compose",
            "node_package_manager",
            "bundler",
            "uv",
            "poetry",
            "go_modules"
          ]
        },
        "cwd": { "type": "string" },
        "file": { "type": "string" },
        "manager": { "enum": ["npm", "pnpm", "yarn", "bundle", "uv", "poetry"] },
        "mode": { "enum": ["install", "ci", "sync", "download"] },
        "group_mode": { "enum": ["with", "only"] },
        "groups": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frozen_lockfile": { "type": "boolean" },
        "no_root": { "type": "boolean" },
        "targets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "allowed": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskEffects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "network": { "type": "boolean" },
        "network_kind": {
          "enum": ["broad", "dependency_hydration"]
        },
        "external_state": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "tasks"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "workflow": { "$ref": "#/$defs/workflowSummary" },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entrypoint": { "type": "string" },
            "default_task": { "type": "string" },
            "safe_tasks": {
              "type": "array",
              "items": { "type": "string" }
            },
            "verify_after_changes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "writable_paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "protected_paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "inferred_boundary_reviewed": { "type": "boolean" },
            "bootstrap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ota": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "note": { "type": "string" },
                    "sh": { "type": "string" },
                    "powershell": { "type": "string" }
                  }
                }
              }
            },
            "notes": { "type": "string" }
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "depends_on", "safe_for_agent"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "notes": { "type": "string" },
              "category": { "type": "string" },
              "context": { "type": "string" },
              "default_mode": { "enum": ["native", "container", "remote"] },
              "env": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "env_files": {
                "type": "array",
                "items": { "type": "string" }
              },
              "adapter_inputs": { "$ref": "#/$defs/taskAdapterInputs" },
              "inputs": {
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/taskInput" }
              },
              "kind": { "enum": ["run", "script", "command", "container", "copy_if_missing", "ensure_env_file", "ensure_file", "ensure_directory", "ensure_bundle", "sequence", "dependency_hydration", "aggregate"] },
              "run": { "type": "string" },
              "script": { "type": "string" },
              "command": { "$ref": "#/$defs/taskCommand" },
              "launch": { "$ref": "#/$defs/taskLaunch" },
              "action": { "$ref": "#/$defs/taskAction" },
              "prepare": { "$ref": "#/$defs/taskPrepare" },
              "aggregate": { "$ref": "#/$defs/taskAggregate" },
              "effects": { "$ref": "#/$defs/taskEffects" },
              "selected_variant_os": { "type": "string" },
              "depends_on": {
                "type": "array",
                "items": { "type": "string" }
              },
              "requires_services": {
                "type": "array",
                "items": { "type": "string" }
              },
              "when_checks": {
                "type": "array",
                "items": { "type": "string" }
              },
              "after_success": {
                "type": "array",
                "items": { "type": "string" }
              },
              "after_failure": {
                "type": "array",
                "items": { "type": "string" }
              },
              "after_always": {
                "type": "array",
                "items": { "type": "string" }
              },
              "safe_for_agent": { "type": "boolean" },
              "internal": { "type": "boolean" },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["os", "kind"],
                  "properties": {
                    "os": { "type": "string" },
                    "kind": { "enum": ["run", "script", "command"] },
                    "run": { "type": "string" },
                    "script": { "type": "string" },
                    "command": { "$ref": "#/$defs/taskCommand" }
                  }
                }
              },
              "modes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode", "has_runtime"],
                  "properties": {
                    "mode": { "enum": ["native", "container", "remote"] },
                    "context": { "type": "string" },
                    "env_files": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "adapter_inputs": { "$ref": "#/$defs/taskAdapterInputs" },
                    "lifecycle": { "enum": ["persistent", "ephemeral"] },
                    "kind": { "enum": ["run", "script", "command", "container", "sequence", "dependency_hydration"] },
                    "run": { "type": "string" },
                    "script": { "type": "string" },
                    "command": { "$ref": "#/$defs/taskCommand" },
                    "launch": { "$ref": "#/$defs/taskLaunch" },
                    "prepare": { "$ref": "#/$defs/taskPrepare" },
                    "has_runtime": { "type": "boolean" }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["member", "tasks"],
            "properties": {
              "member": { "type": "string" },
              "workflow": { "$ref": "#/$defs/workflowSummary" },
              "agent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "entrypoint": { "type": "string" },
                  "default_task": { "type": "string" },
                  "safe_tasks": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "verify_after_changes": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "writable_paths": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "protected_paths": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "inferred_boundary_reviewed": { "type": "boolean" },
                  "bootstrap": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "ota": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "note": { "type": "string" },
                          "sh": { "type": "string" },
                          "powershell": { "type": "string" }
                        }
                      }
                    }
                  },
                  "notes": { "type": "string" }
                }
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "kind", "depends_on", "safe_for_agent"],
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "notes": { "type": "string" },
                    "category": { "type": "string" },
                    "context": { "type": "string" },
                    "default_mode": { "enum": ["native", "container", "remote"] },
                    "env": {
                      "type": "object",
                      "additionalProperties": { "type": "string" }
                    },
                    "env_files": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "adapter_inputs": { "$ref": "#/$defs/taskAdapterInputs" },
                    "inputs": {
                      "type": "object",
                      "additionalProperties": { "$ref": "#/$defs/taskInput" }
                    },
                    "kind": { "enum": ["run", "script", "command", "container", "copy_if_missing", "ensure_env_file", "ensure_file", "ensure_directory", "ensure_bundle", "sequence", "dependency_hydration", "aggregate"] },
                    "run": { "type": "string" },
                    "script": { "type": "string" },
                    "command": { "$ref": "#/$defs/taskCommand" },
                    "launch": { "$ref": "#/$defs/taskLaunch" },
                    "action": { "$ref": "#/$defs/taskAction" },
                    "prepare": { "$ref": "#/$defs/taskPrepare" },
                    "aggregate": { "$ref": "#/$defs/taskAggregate" },
                    "effects": { "$ref": "#/$defs/taskEffects" },
                    "selected_variant_os": { "type": "string" },
                    "depends_on": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "requires_services": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "when_checks": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "after_success": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "after_failure": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "after_always": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "safe_for_agent": { "type": "boolean" },
                    "internal": { "type": "boolean" },
                    "variants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["os", "kind"],
                        "properties": {
                          "os": { "type": "string" },
                          "kind": { "enum": ["run", "script", "command"] },
                          "run": { "type": "string" },
                          "script": { "type": "string" },
                          "command": { "$ref": "#/$defs/taskCommand" }
                        }
                      }
                    },
                    "modes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["mode", "has_runtime"],
                        "properties": {
                          "mode": { "enum": ["native", "container", "remote"] },
                          "context": { "type": "string" },
                          "env_files": {
                            "type": "array",
                            "items": { "type": "string" }
                          },
                          "adapter_inputs": { "$ref": "#/$defs/taskAdapterInputs" },
                          "lifecycle": { "enum": ["persistent", "ephemeral"] },
                          "kind": { "enum": ["run", "script", "command", "container", "sequence", "dependency_hydration"] },
                          "run": { "type": "string" },
                          "script": { "type": "string" },
                          "command": { "$ref": "#/$defs/taskCommand" },
                          "launch": { "$ref": "#/$defs/taskLaunch" },
                          "prepare": { "$ref": "#/$defs/taskPrepare" },
                          "has_runtime": { "type": "boolean" }
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error": { "type": "string" }
      },
      "anyOf": [
        { "required": ["errors"] },
        { "required": ["error"] }
      ]
    }
  ]
}
