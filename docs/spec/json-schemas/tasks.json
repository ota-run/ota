{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/tasks.json",
  "title": "ota tasks --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "tasks"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entrypoint": { "type": "string" },
            "default_task": { "type": "string" },
            "safe_tasks": {
              "type": "array",
              "items": { "type": "string" }
            },
            "verify_after_changes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "writable_paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "notes": { "type": "string" }
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "depends_on", "safe_for_agent"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "category": { "type": "string" },
              "kind": { "enum": ["run", "script"] },
              "run": { "type": "string" },
              "script": { "type": "string" },
              "selected_variant_os": { "type": "string" },
              "depends_on": {
                "type": "array",
                "items": { "type": "string" }
              },
              "safe_for_agent": { "type": "boolean" },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["os", "kind"],
                  "properties": {
                    "os": { "type": "string" },
                    "kind": { "enum": ["run", "script"] },
                    "run": { "type": "string" },
                    "script": { "type": "string" }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["member", "tasks"],
            "properties": {
              "member": { "type": "string" },
              "agent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "entrypoint": { "type": "string" },
                  "default_task": { "type": "string" },
                  "safe_tasks": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "verify_after_changes": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "writable_paths": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "notes": { "type": "string" }
                }
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "kind", "depends_on", "safe_for_agent"],
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "category": { "type": "string" },
                    "kind": { "enum": ["run", "script"] },
                    "run": { "type": "string" },
                    "script": { "type": "string" },
                    "selected_variant_os": { "type": "string" },
                    "depends_on": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "safe_for_agent": { "type": "boolean" },
                    "variants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["os", "kind"],
                        "properties": {
                          "os": { "type": "string" },
                          "kind": { "enum": ["run", "script"] },
                          "run": { "type": "string" },
                          "script": { "type": "string" }
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error": { "type": "string" }
      },
      "anyOf": [
        { "required": ["errors"] },
        { "required": ["error"] }
      ]
    }
  ]
}
