{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/tasks.json",
  "title": "ota tasks --json",
  "$defs": {
    "workflowSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "use": { "$ref": "#/$defs/laneUseSummary" },
        "intent": { "type": "string" },
        "description": { "type": "string" },
        "notes": { "type": "string" },
        "prepare_task": { "type": "string" },
        "setup_task": { "type": "string" },
        "run_task": { "type": "string" },
        "run_task_launch": { "$ref": "#/$defs/taskLaunch" },
        "required_services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_probes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_probes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exposes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expose_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "agentLaneUseSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callable"],
      "properties": {
        "callable": { "type": "boolean" },
        "command": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "laneUseSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human", "agent"],
      "properties": {
        "human": { "type": "string" },
        "agent": { "$ref": "#/$defs/agentLaneUseSummary" }
      }
    },
    "taskLaunchVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target"],
      "properties": {
        "kind": { "enum": ["named"] },
        "source": { "type": "string" },
        "target": { "type": "string" }
      }
    },
    "taskLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["command", "container"] },
        "exe": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "image": { "type": "string" },
        "engine": { "type": "string" },
        "name": { "type": "string" },
        "remove": { "type": "boolean" },
        "volumes": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskLaunchVolume" }
        }
      }
    },
    "taskCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exe"],
      "properties": {
        "exe": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskComposeAdapterInputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cwd": { "type": "string" },
        "env_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "profiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "project_name": { "type": "string" }
      }
    },
    "taskBakeAdapterInputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cwd": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskAdapterInputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compose": { "$ref": "#/$defs/taskComposeAdapterInputs" },
        "bake": { "$ref": "#/$defs/taskBakeAdapterInputs" }
      }
    },
    "taskAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "copy_if_missing" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_env_file" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_file" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "ensure_directory" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "ensure_virtualenv" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "ensure_git_checkout" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "ensure_git_template" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "ensure_git_checkouts" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "ensure_container_network" },
            "provider": { "enum": ["docker"] },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "reset_compose_service_volume" },
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "ensure_bundle" }
          }
        }
      ]
    },
    "taskPrepare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["sequence", "dependency_hydration", "tool_bootstrap"] },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskPrepare" }
        },
        "tool": { "enum": ["uv", "playwright_browsers", "cypress_browsers"] },
        "medium": { "enum": ["container_images", "package_dependencies"] },
        "source": { "$ref": "#/$defs/taskPrepareSource" },
        "source_kind": {
          "enum": [
            "pip",
            "docker_compose",
            "node_package_manager",
            "bundler",
            "uv",
            "poetry",
            "go_modules",
            "maven",
            "gradle",
            "cargo",
            "dotnet_restore"
          ]
        },
        "cwd": { "type": "string" },
        "file": { "type": "string" },
        "engine": { "enum": ["docker", "podman"] },
        "manager": {
          "enum": [
            "npm",
            "pnpm",
            "yarn",
            "bun",
            "bundle",
            "uv",
            "poetry",
            "mvn",
            "./mvnw",
            "gradle",
            "./gradlew",
            "cargo",
            "dotnet"
          ]
        },
        "mode": {
          "enum": [
            "install",
            "ci",
            "sync",
            "pip_requirements",
            "download",
            "uv",
            "playwright_browsers",
            "cypress_browsers",
            "resolve",
            "go-offline",
            "dependencies",
            "fetch",
            "restore"
          ]
        },
        "group_mode": { "enum": ["with", "only"] },
        "groups": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frozen_lockfile": { "type": "boolean" },
        "inline_builds": { "type": "boolean" },
        "force": { "type": "boolean" },
        "no_root": { "type": "boolean" },
        "targets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "allowed": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "taskEffects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "workspace_writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "network": { "type": "boolean" },
        "network_kind": {
          "enum": ["broad", "dependency_hydration", "integration_test", "tool_bootstrap"]
        },
        "adapter_state": {
          "type": "array",
          "items": { "type": "string" }
        },
        "external_state": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "governancePreflightEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence_classes", "receipt_expected", "proof_expected"],
      "properties": {
        "state": { "type": "string" },
        "review_required": { "type": "boolean" },
        "declared_safe_for_agent": { "type": "boolean" },
        "effective_safe_for_agent": { "type": "boolean" },
        "unsafe_closure_tasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "refusal_reason_family": { "type": "string" },
        "refusal": { "$ref": "#/$defs/governanceRefusalRecord" },
        "decision_basis": {
          "type": "array",
          "items": { "$ref": "#/$defs/governanceDecisionBasisEntry" }
        },
        "decision_inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/governanceDecisionInputEntry" }
        },
        "replay": { "$ref": "#/$defs/governanceReplayResult" },
        "evidence_classes": {
          "$ref": "#/$defs/governancePreflightEvidenceClasses"
        },
        "receipt_expected": { "type": "boolean" },
        "proof_expected": { "type": "boolean" }
      }
    },
    "governancePreflightEvidenceClasses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "receipt_expected", "proof_expected"],
      "properties": {
        "state": { "type": "string" },
        "review_required": { "type": "string" },
        "declared_safe_for_agent": { "type": "string" },
        "effective_safe_for_agent": { "type": "string" },
        "unsafe_closure_tasks": { "type": "string" },
        "refusal_reason_family": { "type": "string" },
        "refusal": { "type": "string" },
        "crossing_required": { "type": "string" },
        "crossing_classification": { "type": "string" },
        "crossing_boundary_family": { "type": "string" },
        "decision_inputs": { "type": "string" },
        "replay": { "type": "string" },
        "receipt_expected": { "type": "string" },
        "proof_expected": { "type": "string" }
      }
    },
    "governancePostExecutionEvidenceClasses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "execution_attempted",
        "refusal_occurred",
        "crossing_record_state",
        "receipt_present",
        "proof_present"
      ],
      "properties": {
        "state": { "type": "string" },
        "execution_attempted": { "type": "string" },
        "refusal_occurred": { "type": "string" },
        "refusal_reason_family": { "type": "string" },
        "refusal": { "type": "string" },
        "not_run_reason": { "type": "string" },
        "crossing_record_state": { "type": "string" },
        "decision_inputs": { "type": "string" },
        "replay": { "type": "string" },
        "receipt_present": { "type": "string" },
        "proof_present": { "type": "string" },
        "receipt_status": { "type": "string" }
      }
    },
    "governanceReplayResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["satisfied", "mismatch", "unavailable"] },
        "mismatches": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "governanceDecisionBasisEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "evidence_class"],
      "properties": {
        "id": { "type": "string" },
        "family": { "type": "string" },
        "evidence_class": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "governanceDecisionInputEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "evidence_class", "replay_class"],
      "properties": {
        "id": { "type": "string" },
        "family": { "type": "string" },
        "evidence_class": { "type": "string" },
        "replay_class": { "enum": ["pinned", "witnessed"] },
        "detail": { "type": "string" }
      }
    },
    "governanceRefusalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_family",
        "boundary_family",
        "closure_status",
        "requested_task",
        "blocked_task",
        "evidence_class"
      ],
      "properties": {
        "reason_family": { "type": "string" },
        "boundary_family": { "type": "string" },
        "closure_status": { "type": "string" },
        "requested_task": { "type": "string" },
        "blocked_task": { "type": "string" },
        "closure_path": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_class": { "type": "string" }
      }
    },
    "harnessEnvironmentBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "backend": { "type": "string" },
        "context": { "type": "string" },
        "default_mode": { "type": "string" },
        "primary_task": { "type": "string" }
      }
    },
    "harnessSandboxFilesystemPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source"],
      "properties": {
        "state": { "type": "string" },
        "repo_root_mode": { "type": "string" },
        "writable_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "protected_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source": { "type": "string" }
      }
    },
    "harnessSandboxSharedPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "freshness"],
      "properties": {
        "ref": { "type": "string" },
        "freshness": { "type": "string" }
      }
    },
    "harnessSandboxDestinationConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values", "source_posture", "enforcement"],
      "properties": {
        "kind": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_posture": { "type": "string" },
        "enforcement": { "type": "string" },
        "shared_pin": { "$ref": "#/$defs/harnessSandboxSharedPin" }
      }
    },
    "harnessSandboxOutboundTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string" },
        "value": { "type": "string" },
        "destination_shape": { "type": "string" },
        "destination_constraint": {
          "$ref": "#/$defs/harnessSandboxDestinationConstraint"
        }
      }
    },
    "harnessSandboxNetworkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "default", "scope", "enforcement", "source"],
      "properties": {
        "state": { "type": "string" },
        "default": { "type": "string" },
        "scope": { "type": "string" },
        "enforcement": { "type": "string" },
        "source": { "type": "string" },
        "outbound_targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/harnessSandboxOutboundTarget" }
        }
      }
    },
    "harnessSandboxPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "filesystem", "network"],
      "properties": {
        "target": { "type": "string" },
        "filesystem": { "$ref": "#/$defs/harnessSandboxFilesystemPolicy" },
        "network": { "$ref": "#/$defs/harnessSandboxNetworkPolicy" }
      }
    },
    "harnessLaneCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "lane_kind", "name", "command", "preflight"],
      "properties": {
        "lane_id": { "type": "string" },
        "lane_kind": { "type": "string" },
        "name": { "type": "string" },
        "command": { "type": "string" },
        "environment_boundary": { "$ref": "#/$defs/harnessEnvironmentBoundary" },
        "preflight": { "$ref": "#/$defs/governancePreflightEvaluation" },
        "sandbox_policy": { "$ref": "#/$defs/harnessSandboxPolicy" },
        "effects": { "$ref": "#/$defs/taskEffects" },
        "blocked_task": { "type": "string" },
        "closure_path": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "harnessCapabilityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_mode"],
      "properties": {
        "actor_mode": { "type": "string" },
        "posture": { "type": "string" },
        "entrypoint": { "type": "string" },
        "default_task": { "type": "string" },
        "verify_after_changes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writable_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "protected_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "callable_tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/harnessLaneCapability" }
        },
        "refused_tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/harnessLaneCapability" }
        },
        "callable_workflows": {
          "type": "array",
          "items": { "$ref": "#/$defs/harnessLaneCapability" }
        },
        "refused_workflows": {
          "type": "array",
          "items": { "$ref": "#/$defs/harnessLaneCapability" }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "tasks"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "workflow": { "$ref": "#/$defs/workflowSummary" },
        "capability_profile": { "$ref": "#/$defs/harnessCapabilityProfile" },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "posture": { "type": "string" },
            "entrypoint": { "type": "string" },
            "default_task": { "type": "string" },
            "safe_tasks": {
              "type": "array",
              "items": { "type": "string" }
            },
            "verify_after_changes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "writable_paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "protected_paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "inferred_boundary_reviewed": { "type": "boolean" },
            "bootstrap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ota": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "note": { "type": "string" },
                    "sh": { "type": "string" },
                    "powershell": { "type": "string" }
                  }
                }
              }
            },
            "notes": { "type": "string" }
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "depends_on", "safe_for_agent", "effective_safe_for_agent"],
            "properties": {
              "name": { "type": "string" },
              "use": { "$ref": "#/$defs/laneUseSummary" },
              "description": { "type": "string" },
              "notes": { "type": "string" },
              "category": { "type": "string" },
              "context": { "type": "string" },
              "default_mode": { "enum": ["native", "container", "remote"] },
              "env": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "env_files": {
                "type": "array",
                "items": { "type": "string" }
              },
              "adapter_inputs": { "$ref": "#/$defs/taskAdapterInputs" },
              "inputs": {
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/taskInput" }
              },
              "kind": { "enum": ["run", "script", "command", "container", "copy_if_missing", "ensure_env_file", "ensure_file", "ensure_directory", "ensure_virtualenv", "ensure_git_checkout", "ensure_git_template", "ensure_git_checkouts", "ensure_container_network", "reset_compose_service_volume", "ensure_bundle", "sequence", "dependency_hydration", "tool_bootstrap", "aggregate"] },
              "run": { "type": "string" },
              "script": { "type": "string" },
              "command": { "$ref": "#/$defs/taskCommand" },
              "launch": { "$ref": "#/$defs/taskLaunch" },
              "action": { "$ref": "#/$defs/taskAction" },
              "prepare": { "$ref": "#/$defs/taskPrepare" },
              "aggregate": { "$ref": "#/$defs/taskAggregate" },
              "effects": { "$ref": "#/$defs/taskEffects" },
              "selected_variant_os": { "type": "string" },
