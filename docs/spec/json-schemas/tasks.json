{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ota.run/spec/json-schemas/tasks.json",
  "title": "ota tasks --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "tasks"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "depends_on", "safe_for_agent"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "category": { "type": "string" },
              "kind": { "enum": ["run", "script"] },
              "run": { "type": "string" },
              "script": { "type": "string" },
              "depends_on": {
                "type": "array",
                "items": { "type": "string" }
              },
              "safe_for_agent": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error": { "type": "string" }
      },
      "anyOf": [
        { "required": ["errors"] },
        { "required": ["error"] }
      ]
    }
  ]
}
