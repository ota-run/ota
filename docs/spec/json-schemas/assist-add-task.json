{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/assist-add-task.json",
  "title": "ota assist add-task --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "path",
        "mode",
        "operation",
        "subject",
        "inputs",
        "assumptions",
        "changes",
        "diff",
        "validation",
        "next"
      ],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "mode": { "enum": ["preview", "write"] },
        "operation": { "const": "add-task" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task"],
          "properties": {
            "task": { "type": "string" }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "internal"],
          "properties": {
            "kind": { "enum": ["command", "service", "setup", "check", "sandbox"] },
            "run": { "type": "string" },
            "script": { "type": "string" },
            "description": { "type": "string" },
            "internal": { "enum": ["true", "false"] },
            "listener": { "type": "string" },
            "protocol": { "enum": ["http", "tcp"] },
            "address": { "type": "string" },
            "port": { "type": "string" }
          }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "before", "after"],
            "properties": {
              "path": { "type": "string" },
              "action": { "const": "set" },
              "before": {},
              "after": {}
            }
          }
        },
        "diff": { "type": "string" },
        "validation": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "operation", "subject", "why", "next"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "operation": { "const": "add-task" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task"],
          "properties": {
            "task": { "type": "string" }
          }
        },
        "why": { "type": "string" },
        "next": { "type": "string" }
      }
    }
  ]
}
