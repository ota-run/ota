{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/doctor.json",
  "title": "ota doctor --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "mode", "summary", "findings"],
  "$defs": {
    "claimAssurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "family", "declaration", "closure", "assurance", "policy"],
      "properties": {
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "family": { "enum": ["agent_safety", "declared_effects", "proof_breadth", "effect_refusal_assurance"] },
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "evidence_class"],
          "properties": {
            "value": { "type": "string" },
            "evidence_class": { "enum": ["asserted", "derived", "attested"] }
          }
        },
        "closure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence_class"],
          "properties": {
            "status": { "enum": ["safe", "unsafe", "unavailable", "resolved"] },
            "blockers": {
              "type": "array",
              "items": { "type": "string" }
            },
            "evidence_class": { "enum": ["derived"] }
          }
        },
        "assurance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "coverage"],
          "properties": {
            "status": { "enum": ["supported", "contradicted", "unknown"] },
            "coverage": {
              "type": "array",
              "items": { "type": "string" }
            },
            "contract_snapshot_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "discovery_scope": { "type": "string", "minLength": 1 },
            "coverage_records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "status", "path", "evidence_class"],
                "properties": {
                  "kind": { "enum": ["declared_challenge_lane", "equivalent_execution_path", "opaque_execution_paths"] },
                  "status": { "enum": ["verified", "not_verified", "not_proved", "incomplete"] },
                  "path": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "effect_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "attachment_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "evidence_class": { "enum": ["derived", "attested"] }
                },
                "allOf": [
                  {
                    "if": { "properties": { "kind": { "const": "declared_challenge_lane" } }, "required": ["kind"] },
                    "then": {
                      "required": ["effect_identity", "attachment_identity"],
                      "properties": {
                        "status": { "enum": ["verified", "not_verified"] },
                        "evidence_class": { "enum": ["derived", "attested"] }
                      },
                      "allOf": [
                        {
                          "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
                          "then": { "properties": { "evidence_class": { "const": "attested" } }, "required": ["evidence_class"] },
                          "else": { "properties": { "evidence_class": { "const": "derived" } }, "required": ["evidence_class"] }
                        }
                      ]
                    }
                  },
                  {
                    "if": { "properties": { "kind": { "const": "equivalent_execution_path" } }, "required": ["kind"] },
                    "then": {
                      "required": ["effect_identity", "attachment_identity"],
                      "properties": {
                        "status": { "const": "not_proved" },
                        "evidence_class": { "const": "derived" }
                      }
                    }
                  },
                  {
                    "if": { "properties": { "kind": { "const": "opaque_execution_paths" } }, "required": ["kind"] },
                    "then": {
                      "properties": {
                        "status": { "const": "not_proved" },
                        "evidence_class": { "const": "derived" },
                        "effect_identity": false,
                        "attachment_identity": false
                      }
                    }
                  }
                ]
              }
            },
            "gaps": {
              "type": "array",
              "items": { "type": "string" }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "source", "evidence_class"],
                "properties": {
                  "id": { "type": "string" },
                  "source": { "type": "string" },
                  "evidence_class": { "enum": ["asserted", "derived", "attested"] }
                }
              }
            },
            "contradictions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "source", "evidence_class"],
                "properties": {
                  "id": { "type": "string" },
                  "source": { "type": "string" },
                  "evidence_class": { "enum": ["asserted", "derived", "attested"] }
                }
              }
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "basis", "evidence_class"],
          "properties": {
            "decision": { "enum": ["allow", "deny", "review"] },
            "basis": {
              "type": "array",
              "items": { "type": "string" }
            },
            "evidence_class": { "enum": ["derived"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "family": { "const": "effect_refusal_assurance" } }, "required": ["family"] },
          "then": {
            "properties": {
              "subject": {
                "properties": { "kind": { "const": "effect_refusal_canary" } },
                "required": ["kind"]
              },
              "declaration": {
                "properties": {
                  "value": { "const": "explicit_typed_deny" },
                  "evidence_class": { "const": "asserted" }
                },
                "required": ["value", "evidence_class"]
              },
              "assurance": {
                "required": ["contract_snapshot_identity", "discovery_scope", "coverage_records", "gaps"],
                "properties": {
                  "coverage": {
                    "allOf": [
                      { "contains": { "const": "contract_effect_graph" } },
                      { "contains": { "const": "declared_challenge_lanes" } }
                    ]
                  },
                  "discovery_scope": { "const": "typed_contract_graph_v1" },
                  "coverage_records": {
                    "minItems": 2,
                    "allOf": [
                      { "contains": { "properties": { "kind": { "const": "declared_challenge_lane" } }, "required": ["kind"] } },
                      { "contains": { "properties": { "kind": { "const": "opaque_execution_paths" } }, "required": ["kind"] } }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "coverage_records": {
                          "contains": {
                            "properties": { "kind": { "const": "equivalent_execution_path" } },
                            "required": ["kind"]
                          }
                        }
                      },
                      "required": ["coverage_records"]
                    },
                    "then": {
                      "properties": {
                        "gaps": {
                          "contains": {
                            "type": "string",
                            "pattern": "^equivalent_execution_paths_not_proved:sha256:[0-9a-f]{64}$"
                          }
                        }
                      },
                      "required": ["gaps"]
                    }
                  }
                ],
                "required": ["status", "coverage", "contract_snapshot_identity", "discovery_scope", "coverage_records", "gaps"]
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "properties": {
                      "closure": {
                        "properties": {
                          "status": { "const": "unavailable" },
                          "blockers": { "contains": { "const": "verified_effect_refusal_archive" } }
                        },
                        "required": ["status", "blockers"]
                      },
                      "assurance": {
                        "properties": {
                          "status": { "const": "unknown" },
                          "gaps": {
                            "allOf": [
                              { "contains": { "const": "verified_effect_refusal_archive" } },
                              { "contains": { "const": "effect_realization_not_verified" } },
                              { "contains": { "const": "opaque_execution_paths_not_enumerated" } }
                            ]
                          },
                          "coverage_records": {
                            "items": {
                              "allOf": [
                                {
                                  "if": {
                                    "properties": { "kind": { "const": "declared_challenge_lane" } },
                                    "required": ["kind"]
                                  },
                                  "then": {
                                    "properties": {
                                      "status": { "const": "not_verified" },
                                      "evidence_class": { "const": "derived" }
                                    },
                                    "required": ["status", "evidence_class"]
                                  }
                                }
                              ]
                            }
                          },
                          "evidence": {
                            "items": {
                              "not": {
                                "anyOf": [
                                  {
                                    "properties": { "id": { "type": "string", "pattern": "^effect_refusal_archive:" } },
                                    "required": ["id"]
                                  },
                                  {
                                    "properties": { "source": { "type": "string", "pattern": "^private_receipt_archive:" } },
                                    "required": ["source"]
                                  }
                                ]
                              }
                            }
                          }
                        },
                        "required": ["status", "gaps"]
                      }
                    },
                    "required": ["closure", "assurance"]
                  },
                  {
                    "properties": {
                      "closure": {
                        "properties": { "status": { "const": "resolved" }, "blockers": false },
                        "required": ["status"]
                      },
                      "assurance": {
                        "properties": {
                          "status": { "const": "supported" },
                          "coverage": { "contains": { "const": "verified_effect_refusal_archives" } },
                          "coverage_records": {
                            "contains": {
                              "properties": {
                                "kind": { "const": "declared_challenge_lane" },
                                "status": { "const": "verified" },
                                "evidence_class": { "const": "attested" },
                                "path": {
                                  "type": "array",
                                  "minItems": 4,
                                  "prefixItems": [
                                    { "const": "agent" },
                                    { "const": "effect_refusal_canaries" },
                                    { "const": "workflows" }
                                  ]
                                }
                              },
                              "required": ["kind", "status", "evidence_class", "path"]
                            },
                            "items": {
                              "allOf": [
                                {
                                  "if": {
                                    "properties": { "kind": { "const": "declared_challenge_lane" } },
                                    "required": ["kind"]
                                  },
                                  "then": {
                                    "properties": {
                                      "status": { "const": "verified" },
                                      "evidence_class": { "const": "attested" },
                                      "path": {
                                        "type": "array",
                                        "minItems": 4,
                                        "prefixItems": [
                                          { "const": "agent" },
                                          { "const": "effect_refusal_canaries" },
                                          { "const": "workflows" }
                                        ]
                                      }
                                    },
                                    "required": ["status", "evidence_class", "path"]
                                  }
                                }
                              ]
                            }
                          },
                          "gaps": {
                            "allOf": [{ "contains": { "const": "opaque_execution_paths_not_enumerated" } }],
                            "not": {
                              "anyOf": [
                                { "contains": { "const": "verified_effect_refusal_archive" } },
                                { "contains": { "const": "effect_realization_not_verified" } }
                              ]
                            }
                          },
                          "evidence": {
                            "contains": {
                              "properties": {
                                "id": { "type": "string", "pattern": "^effect_refusal_archive:sha256:[0-9a-f]{64}$" },
                                "source": { "type": "string", "pattern": "^private_receipt_archive:sha256:[0-9a-f]{64}:realization:sha256:[0-9a-f]{64}$" },
                                "evidence_class": { "const": "attested" }
                              },
                              "required": ["id", "source", "evidence_class"]
                            },
                            "items": {
                              "properties": {
                                "id": { "type": "string", "pattern": "^effect_refusal_archive:sha256:[0-9a-f]{64}$" },
                                "source": { "type": "string", "pattern": "^private_receipt_archive:sha256:[0-9a-f]{64}:realization:sha256:[0-9a-f]{64}$" },
                                "evidence_class": { "const": "attested" }
                              },
                              "required": ["id", "source", "evidence_class"]
                            }
                          },
                          "contradictions": {
                            "maxItems": 0
                          }
                        },
                        "required": ["status", "coverage", "coverage_records", "gaps", "evidence"]
                      }
                    },
                    "required": ["closure", "assurance"]
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "replayInputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_identity", "subject", "required", "decision", "coverage"],
      "properties": {
        "policy_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "enum": ["task", "workflow"] },
            "name": { "type": "string" }
          }
        },
        "required": { "type": "boolean" },
        "decision": { "enum": ["allow", "deny", "review"] },
        "coverage": { "enum": ["not_required", "complete", "insufficient"] },
        "applicable_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identity", "subject", "on_insufficient", "closure_tasks", "input_keys", "coverage", "decision"],
            "properties": {
              "identity": { "type": "string" },
              "subject": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "name"],
                "properties": {
                  "kind": { "enum": ["task", "workflow"] },
                  "name": { "type": "string" }
                }
              },
              "on_insufficient": { "enum": ["deny", "review"] },
              "closure_tasks": { "type": "array", "items": { "type": "string" } },
              "input_keys": { "type": "array", "items": { "type": "string" } },
              "coverage": { "enum": ["complete", "insufficient"] },
              "decision": { "enum": ["allow", "deny", "review"] },
              "reasons": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task", "id", "path", "status"],
            "properties": {
              "task": { "type": "string" },
              "id": { "type": "string" },
              "path": { "type": "string" },
              "expected_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "observed_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "status": { "enum": ["matched", "mismatched", "missing", "unpinned", "unpinned_unreadable", "observation_unavailable"] },
              "error": { "type": "string" }
            }
          }
        },
        "unknown_selectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identity", "subject", "reason"],
            "properties": {
              "identity": { "type": "string" },
              "subject": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "name"],
                "properties": {
                  "kind": { "enum": ["task", "workflow"] },
                  "name": { "type": "string" }
                }
              },
              "reason": { "enum": ["unknown_task_selector", "unknown_workflow_selector"] }
            }
          }
        }
      }
    },
    "toolchainSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider",
        "backend",
        "target_os",
        "version",
        "fulfillment",
        "required",
        "owns_runtime"
      ],
      "properties": {
        "name": { "type": "string" },
        "provider": { "type": "string" },
        "backend": { "type": "string" },
        "target_os": { "type": "string" },
        "version": { "type": "string" },
        "fulfillment": { "enum": ["none", "run"] },
        "required": { "type": "boolean" },
        "owns_runtime": { "type": "string" },
        "fulfilled": { "type": "boolean" },
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "owns_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "targets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "workflowSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "use": { "$ref": "./tasks.json#/$defs/laneUseSummary" },
        "intent": { "type": "string" },
        "description": { "type": "string" },
        "notes": { "type": "string" },
        "prepare_task": { "type": "string" },
        "setup_task": { "type": "string" },
        "run_task": { "type": "string" },
        "declared_safe_for_agent": { "type": "boolean" },
        "effective_safe_for_agent": { "type": "boolean" },
        "run_task_launch": { "$ref": "./execution.json#/$defs/taskLaunch" },
        "required_services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_probes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_probes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exposes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expose_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "mode": { "enum": ["native", "container", "remote"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "agent_verdict", "error_count", "warn_count", "info_count"],
      "properties": {
        "verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "agent_verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "error_count": { "type": "integer", "minimum": 0 },
        "warn_count": { "type": "integer", "minimum": 0 },
        "info_count": { "type": "integer", "minimum": 0 },
        "primary_blocker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["severity", "summary", "why", "next"],
          "properties": {
            "severity": { "enum": ["error", "warn", "info"] },
            "summary": { "type": "string" },
            "why": { "type": "string" },
            "next": { "type": "string" },
            "code": { "type": "string" },
            "provenance": { "type": "string" },
            "provenance_key": { "type": "string" }
          }
        }
      }
    },
    "workflow": { "$ref": "#/$defs/workflowSummary" },
    "secret_delivery_admission": {
      "$ref": "./secret-delivery-admission.json"
    },
    "claim_assurance": {
      "type": "array",
      "items": { "$ref": "#/$defs/claimAssurance" }
    },
    "replay_input_policy": { "$ref": "#/$defs/replayInputPolicy" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "posture": {
          "enum": ["readiness_strict", "contract_authoring", "infra_authoring"]
        },
        "entrypoint": { "type": "string" },
        "default_task": { "type": "string" },
        "safe_tasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verify_after_changes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writable_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "protected_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inferred_boundary_reviewed": { "type": "boolean" },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ota": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "note": { "type": "string" },
                "sh": { "type": "string" },
                "powershell": { "type": "string" }
              }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_context": { "type": "string" },
        "contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "backend"],
            "properties": {
              "name": { "type": "string" },
              "backend": { "type": "string" }
            }
          }
        },
        "preferred": { "enum": ["native", "container", "remote"] },
        "supported": {
          "type": "array",
          "items": { "enum": ["native", "container", "remote"] }
        },
        "lifecycle": { "enum": ["persistent", "ephemeral"] },
        "backends": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "container": {
              "type": "object",
              "additionalProperties": false,
              "required": ["image"],
              "properties": {
                "image": { "type": "string" }
              }
            },
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider"],
              "properties": {
                "provider": { "type": "string" },
                "target": { "type": "string" },
                "cwd": { "type": "string" }
              }
            }
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "required"],
            "properties": {
              "name": { "type": "string" },
              "required": { "type": "boolean" },
              "default": { "type": "string" },
              "policy": { "type": "string" },
              "source": { "type": "string" },
              "allowed": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "toolchains": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolchainSelection" }
    },
    "provisioning": { "$ref": "./shared.json#/$defs/provisioningPlan" },
    "provisioning_request": {
      "$ref": "./shared.json#/$defs/provisioningBackendRequest"
    },
    "adapter_bootstrap": {
      "$ref": "./shared.json#/$defs/adapterBootstrapDiagnostics"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "command", "api_version"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["check_provider", "export_provider", "backend_provider"]
          },
          "command": { "type": "string" },
          "api_version": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "config": { "type": "object" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "./shared.json#/$defs/finding" }
    },
    "finding_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_key", "action_title", "action_next", "count"],
        "properties": {
          "action_key": { "type": "string" },
          "action_title": { "type": "string" },
          "action_next": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "ok", "findings"],
        "properties": {
          "member": { "type": "string" },
          "ok": { "type": "boolean" },
          "workflow": { "$ref": "#/properties/workflow" },
          "toolchains": {
            "type": "array",
            "items": { "$ref": "#/$defs/toolchainSelection" }
          },
          "replay_input_policy": { "$ref": "#/$defs/replayInputPolicy" },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "posture": {
                "enum": ["readiness_strict", "contract_authoring", "infra_authoring"]
              },
              "entrypoint": { "type": "string" },
              "default_task": { "type": "string" },
              "safe_tasks": {
                "type": "array",
                "items": { "type": "string" }
              },
              "verify_after_changes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "writable_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "protected_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "inferred_boundary_reviewed": { "type": "boolean" },
              "bootstrap": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ota": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "note": { "type": "string" },
                      "sh": { "type": "string" },
                      "powershell": { "type": "string" }
                    }
                  }
                }
              },
              "notes": { "type": "string" }
            }
          },
          "findings": {
            "type": "array",
            "items": { "$ref": "./shared.json#/$defs/finding" }
          }
        }
      }
    }
  }
}
