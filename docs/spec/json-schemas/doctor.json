{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ota.run/spec/json-schemas/doctor.json",
  "title": "ota doctor --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "findings"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrypoint": { "type": "string" },
        "default_task": { "type": "string" },
        "safe_tasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verify_after_changes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writable_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred": { "enum": ["native", "container", "remote"] },
        "supported": {
          "type": "array",
          "items": { "enum": ["native", "container", "remote"] }
        },
        "lifecycle": { "enum": ["persistent", "ephemeral"] },
        "backends": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "container": {
              "type": "object",
              "additionalProperties": false,
              "required": ["image"],
              "properties": {
                "image": { "type": "string" }
              }
            },
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider"],
              "properties": {
                "provider": { "type": "string" },
                "target": { "type": "string" },
                "cwd": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "./shared.json#/$defs/finding" }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "ok", "findings"],
        "properties": {
          "member": { "type": "string" },
          "ok": { "type": "boolean" },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entrypoint": { "type": "string" },
              "default_task": { "type": "string" },
              "safe_tasks": {
                "type": "array",
                "items": { "type": "string" }
              },
              "verify_after_changes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "writable_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "notes": { "type": "string" }
            }
          },
          "findings": {
            "type": "array",
            "items": { "$ref": "./shared.json#/$defs/finding" }
          }
        }
      }
    }
  }
}
