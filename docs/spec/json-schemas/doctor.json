{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/doctor.json",
  "title": "ota doctor --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "mode", "summary", "findings"],
  "$defs": {
    "toolchainSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider",
        "backend",
        "target_os",
        "version",
        "fulfillment",
        "required",
        "owns_runtime"
      ],
      "properties": {
        "name": { "type": "string" },
        "provider": { "type": "string" },
        "backend": { "type": "string" },
        "target_os": { "type": "string" },
        "version": { "type": "string" },
        "fulfillment": { "enum": ["none", "run"] },
        "required": { "type": "boolean" },
        "owns_runtime": { "type": "string" },
        "fulfilled": { "type": "boolean" },
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "owns_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "targets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "workflowSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "intent": { "type": "string" },
        "description": { "type": "string" },
        "notes": { "type": "string" },
        "prepare_task": { "type": "string" },
        "setup_task": { "type": "string" },
        "run_task": { "type": "string" },
        "run_task_launch": { "$ref": "./execution.json#/$defs/taskLaunch" },
        "required_services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_probes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_probes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal_readiness_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exposes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expose_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "mode": { "enum": ["native", "container"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "agent_verdict", "error_count", "warn_count", "info_count"],
      "properties": {
        "verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "agent_verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "error_count": { "type": "integer", "minimum": 0 },
        "warn_count": { "type": "integer", "minimum": 0 },
        "info_count": { "type": "integer", "minimum": 0 }
      }
    },
    "workflow": { "$ref": "#/$defs/workflowSummary" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrypoint": { "type": "string" },
        "default_task": { "type": "string" },
        "safe_tasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verify_after_changes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writable_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "protected_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inferred_boundary_reviewed": { "type": "boolean" },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ota": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "note": { "type": "string" },
                "sh": { "type": "string" },
                "powershell": { "type": "string" }
              }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred": { "enum": ["native", "container", "remote"] },
        "supported": {
          "type": "array",
          "items": { "enum": ["native", "container", "remote"] }
        },
        "lifecycle": { "enum": ["persistent", "ephemeral"] },
        "backends": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "container": {
              "type": "object",
              "additionalProperties": false,
              "required": ["image"],
              "properties": {
                "image": { "type": "string" }
              }
            },
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider"],
              "properties": {
                "provider": { "type": "string" },
                "target": { "type": "string" },
                "cwd": { "type": "string" }
              }
            }
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "required"],
            "properties": {
              "name": { "type": "string" },
              "required": { "type": "boolean" },
              "default": { "type": "string" },
              "policy": { "type": "string" },
              "allowed": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "toolchains": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolchainSelection" }
    },
    "provisioning": { "$ref": "./shared.json#/$defs/provisioningPlan" },
    "provisioning_request": {
      "$ref": "./shared.json#/$defs/provisioningBackendRequest"
    },
    "adapter_bootstrap": {
      "$ref": "./shared.json#/$defs/adapterBootstrapDiagnostics"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "command", "api_version"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["check_provider", "export_provider", "backend_provider"]
          },
          "command": { "type": "string" },
          "api_version": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "config": { "type": "object" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "./shared.json#/$defs/finding" }
    },
    "finding_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_key", "action_title", "action_next", "count"],
        "properties": {
          "action_key": { "type": "string" },
          "action_title": { "type": "string" },
          "action_next": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "ok", "findings"],
        "properties": {
          "member": { "type": "string" },
          "ok": { "type": "boolean" },
          "toolchains": {
            "type": "array",
            "items": { "$ref": "#/$defs/toolchainSelection" }
          },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entrypoint": { "type": "string" },
              "default_task": { "type": "string" },
              "safe_tasks": {
                "type": "array",
                "items": { "type": "string" }
              },
              "verify_after_changes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "writable_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "protected_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "inferred_boundary_reviewed": { "type": "boolean" },
              "bootstrap": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ota": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "note": { "type": "string" },
                      "sh": { "type": "string" },
                      "powershell": { "type": "string" }
                    }
                  }
                }
              },
              "notes": { "type": "string" }
            }
          },
          "findings": {
            "type": "array",
            "items": { "$ref": "./shared.json#/$defs/finding" }
          }
        }
      }
    }
  }
}
