{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/doctor.json",
  "title": "ota doctor --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "summary", "findings"],
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "agent_verdict", "error_count", "warn_count", "info_count"],
      "properties": {
        "verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "agent_verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "error_count": { "type": "integer", "minimum": 0 },
        "warn_count": { "type": "integer", "minimum": 0 },
        "info_count": { "type": "integer", "minimum": 0 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrypoint": { "type": "string" },
        "default_task": { "type": "string" },
        "safe_tasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verify_after_changes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writable_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ota": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "note": { "type": "string" },
                "sh": { "type": "string" },
                "powershell": { "type": "string" }
              }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred": { "enum": ["native", "container", "remote"] },
        "supported": {
          "type": "array",
          "items": { "enum": ["native", "container", "remote"] }
        },
        "lifecycle": { "enum": ["persistent", "ephemeral"] },
        "backends": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "container": {
              "type": "object",
              "additionalProperties": false,
              "required": ["image"],
              "properties": {
                "image": { "type": "string" }
              }
            },
            "remote": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider"],
              "properties": {
                "provider": { "type": "string" },
                "target": { "type": "string" },
                "cwd": { "type": "string" }
              }
            }
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "required"],
            "properties": {
              "name": { "type": "string" },
              "required": { "type": "boolean" },
              "default": { "type": "string" },
              "policy": { "type": "string" },
              "allowed": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "command", "api_version"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["check_provider", "export_provider", "backend_provider"]
          },
          "command": { "type": "string" },
          "api_version": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "config": { "type": "object" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "./shared.json#/$defs/finding" }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "ok", "findings"],
        "properties": {
          "member": { "type": "string" },
          "ok": { "type": "boolean" },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entrypoint": { "type": "string" },
              "default_task": { "type": "string" },
              "safe_tasks": {
                "type": "array",
                "items": { "type": "string" }
              },
              "verify_after_changes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "writable_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "bootstrap": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ota": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "note": { "type": "string" },
                      "sh": { "type": "string" },
                      "powershell": { "type": "string" }
                    }
                  }
                }
              },
              "notes": { "type": "string" }
            }
          },
          "findings": {
            "type": "array",
            "items": { "$ref": "./shared.json#/$defs/finding" }
          }
        }
      }
    }
  }
}
