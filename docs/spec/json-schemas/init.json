{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/init.json",
  "title": "ota init --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "mode", "config", "inferred", "provenance"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "written": { "type": "boolean" },
        "mode": {
          "enum": [
            "blank",
            "detected",
            "pack"
          ]
        },
        "pack": {
          "enum": [
            "node",
            "python",
            "go",
            "rust",
            "java-maven",
            "java-gradle"
          ]
        },
        "pack_advisory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_pack",
            "suggested_pack",
            "summary",
            "next"
          ],
          "properties": {
            "selected_pack": {
              "type": "string"
            },
            "suggested_pack": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "signals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "next": {
              "type": "string"
            }
          }
        },
        "config": { "type": "object" },
        "inferred": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/inference" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/contractFieldProvenance" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "mode",
        "packs"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "mode": {
          "const": "catalog"
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "summary",
              "when",
              "command",
              "next",
              "seeds"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "next": {
                "type": "string"
              },
              "seeds": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "runtimes",
                  "tools",
                  "checks",
                  "tasks"
                ],
                "properties": {
                  "runtimes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tasks": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "error"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "written": { "const": false },
        "error": { "type": "string" },
        "next": { "type": "string" }
      }
    }
  ]
}
