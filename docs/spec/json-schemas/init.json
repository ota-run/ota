{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/init.json",
  "title": "ota init --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "mode", "config", "inferred", "provenance"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "written": { "type": "boolean" },
        "mode": {
          "enum": [
            "blank",
            "detected",
            "pack"
          ]
        },
        "preview_candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate", "identity", "schema_version", "profile", "resulting_contract_identity"],
          "properties": {
            "candidate": {
              "allOf": [
                { "$ref": "./contract-candidate.json" },
                {
                  "type": "object",
                  "required": ["schema_version", "profile"],
                  "properties": {
                    "schema_version": { "const": 4 },
                    "profile": { "const": "init_starter_preview_v1" }
                  }
                }
              ]
            },
            "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "schema_version": { "const": 4 },
            "profile": { "const": "init_starter_preview_v1" },
            "resulting_contract_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "pack": {
          "enum": [
            "node",
            "python",
            "go",
            "rust",
            "dotnet",
            "php-composer",
            "java-maven",
            "java-gradle"
          ]
        },
        "pack_options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "package_manager": {
              "enum": [
                "npm",
                "pnpm",
                "yarn",
                "bun"
              ]
            },
            "test_runner": {
              "enum": [
                "pytest",
                "unittest"
              ]
            }
          }
        },
        "pack_advisory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_pack",
            "suggested_pack",
            "selected_pack_score",
            "suggested_pack_score",
            "summary",
            "next"
          ],
          "properties": {
            "selected_pack": {
              "type": "string"
            },
            "suggested_pack": {
              "type": "string"
            },
            "selected_pack_score": {
              "type": "integer",
              "minimum": 0
            },
            "suggested_pack_score": {
              "type": "integer",
              "minimum": 0
            },
            "score_gap": {
              "type": "integer",
              "minimum": 1
            },
            "summary": {
              "type": "string"
            },
            "signals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "signal_details": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "signal",
                  "weight"
                ],
                "properties": {
                  "signal": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "selected_signal_details": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "signal",
                  "weight"
                ],
                "properties": {
                  "signal": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "next": {
              "type": "string"
            }
          }
        },
        "config": { "type": "object" },
        "inferred": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/inference" }
        },
        "toolchain_opportunities": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/toolchainOpportunity" }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/contractFieldProvenance" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "written": { "const": false } }, "required": ["written"] },
          "then": { "required": ["preview_candidate"] }
        },
        {
          "if": { "required": ["preview_candidate"] },
          "then": { "properties": { "written": { "const": false } } }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "mode",
        "packs"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "mode": {
          "const": "catalog"
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "summary",
              "when",
              "command",
              "next",
              "seeds"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "next": {
                "type": "string"
              },
              "does_not_infer": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "flag",
                    "summary",
                    "default",
                    "values"
                  ],
                  "properties": {
                    "flag": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "default": {
                      "type": "string"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "seeds": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "toolchains",
                  "runtimes",
                  "tools",
                  "checks",
                  "tasks"
                ],
                "properties": {
                  "toolchains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "runtimes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tasks": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "written", "error"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "written": { "const": false },
        "error": { "type": "string" },
        "next": { "type": "string" }
      }
    }
  ]
}
