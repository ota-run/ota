{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/validate.json",
  "title": "ota validate --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["error_count", "warn_count"],
          "properties": {
            "error_count": { "type": "integer" },
            "warn_count": { "type": "integer" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["error_count", "warn_count"],
          "properties": {
            "error_count": { "type": "integer" },
            "warn_count": { "type": "integer" }
          }
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error": { "type": "string" }
      },
      "anyOf": [
        { "required": ["errors"] },
        { "required": ["error"] }
      ]
    }
  ]
}
