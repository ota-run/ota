{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/run-preview.json",
  "title": "ota run --dry-run --json",
  "$defs": {
    "envSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_count",
        "source_count",
        "source_issue_count",
        "task_count",
        "resolved_count",
        "missing_count",
        "invalid_count"
      ],
      "properties": {
        "contract_count": { "type": "integer", "minimum": 0 },
        "source_count": { "type": "integer", "minimum": 0 },
        "source_issue_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 },
        "resolved_count": { "type": "integer", "minimum": 0 },
        "missing_count": { "type": "integer", "minimum": 0 },
        "invalid_count": { "type": "integer", "minimum": 0 }
      }
    },
    "envSourceStatus": {
      "enum": [
        "loaded",
        "missing_optional",
        "missing_required",
        "parse_failed",
        "invalid_structure",
        "collision"
      ]
    },
    "envSourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "label", "must_exist", "status"],
      "properties": {
        "kind": { "type": "string" },
        "path": { "type": "string" },
        "label": { "type": "string" },
        "must_exist": { "type": "boolean" },
        "status": { "$ref": "#/$defs/envSourceStatus" },
        "detail": { "type": "string" },
        "next": { "type": "string" }
      }
    },
    "envEntryKind": {
      "enum": ["contract", "task"]
    },
    "envEntryStatus": {
      "enum": ["resolved", "missing", "optional", "invalid", "task"]
    },
    "envEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "required", "source", "status"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/envEntryKind" },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "allowed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "value": { "type": "string" },
        "source": { "type": "string" },
        "source_kind": { "type": "string" },
        "source_path": { "type": "string" },
        "source_status": { "$ref": "#/$defs/envSourceStatus" },
        "source_label": { "type": "string" },
        "status": { "$ref": "#/$defs/envEntryStatus" },
        "next": { "type": "string" }
      }
    },
    "sha256Identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sandboxRestrictionOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "source"],
      "properties": {
        "identity": { "$ref": "#/$defs/sha256Identity" },
        "source": { "type": "string", "minLength": 1 },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo_root_mode": { "enum": ["read_only", "read_write"] },
            "writable_paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "protected_paths": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": { "enum": ["allow", "deny"] },
            "outbound_targets": {
              "type": "array",
              "items": {
                "$ref": "./contract.json#/$defs/runtimeBoundaryOutboundTarget"
              }
            }
          }
        }
      }
    },
    "sandboxTargetPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "platform": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?$"
        }
      }
    },
    "sandboxPolicyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "source", "destination", "condition", "order"],
      "properties": {
        "identity": { "$ref": "#/$defs/sha256Identity" },
        "source": { "type": "string", "minLength": 1 },
        "destination": { "type": "string", "minLength": 1 },
        "condition": {
          "enum": ["unconditional", "on_success", "on_failure", "always"]
        },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "sandboxPolicySegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identity",
        "task",
        "phase",
        "order",
        "target_platform",
        "backend",
        "interaction",
        "execution_kind",
        "runtime_boundary",
        "effects"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "identity": { "$ref": "#/$defs/sha256Identity" },
        "task": { "type": "string", "minLength": 1 },
        "phase": {
          "enum": ["prepare", "setup", "run", "attach", "dependency", "hook"]
        },
        "order": { "type": "integer", "minimum": 0 },
        "target_platform": { "$ref": "#/$defs/sandboxTargetPlatform" },
        "runtime_image": { "type": "string", "minLength": 1 },
        "backend": { "enum": ["native", "container", "remote"] },
        "context": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["ephemeral", "persistent"] },
        "interaction": { "enum": ["auto", "forbidden", "required"] },
        "inherited_service_networks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "isolated_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "pre_boundary_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "execution_kind": { "type": "string", "minLength": 1 },
        "runtime_boundary": {
          "$ref": "./contract.json#/$defs/runtimeBoundary"
        },
        "effects": { "$ref": "./contract.json#/$defs/taskEffects" }
      }
    },
    "sandboxCanonicalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "identity",
        "contract_identity",
        "lane",
        "target_platform",
        "segments",
        "edges"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "identity": { "$ref": "#/$defs/sha256Identity" },
        "contract_identity": { "$ref": "#/$defs/sha256Identity" },
        "lane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "enum": ["task", "workflow"] },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "target_platform": { "$ref": "#/$defs/sandboxTargetPlatform" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sandboxPolicySegment" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/sandboxPolicyEdge" }
        }
      }
    },
    "sandboxEffectivePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "canonical_identity",
        "restriction_overlays",
        "restriction_overlay_identities",
        "segments",
        "edges"
      ],
      "properties": {
        "identity": { "$ref": "#/$defs/sha256Identity" },
        "canonical_identity": { "$ref": "#/$defs/sha256Identity" },
        "restriction_overlays": {
          "type": "array",
          "items": { "$ref": "#/$defs/sandboxRestrictionOverlay" }
        },
        "restriction_overlay_identities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256Identity" }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sandboxPolicySegment" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/sandboxPolicyEdge" }
        }
      }
    },
    "sandboxProviderEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted",
        "identity",
        "provider_target",
        "canonical_policy_identity",
        "effective_policy_identity",
        "capability_identity",
        "segment_applications",
        "refusals"
      ],
      "properties": {
        "admitted": { "const": true },
        "identity": { "$ref": "#/$defs/sha256Identity" },
        "provider_target": { "const": "oci_local" },
        "canonical_policy_identity": { "$ref": "#/$defs/sha256Identity" },
        "effective_policy_identity": { "$ref": "#/$defs/sha256Identity" },
        "capability_identity": { "$ref": "#/$defs/sha256Identity" },
        "segment_applications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "segment_policy_identity",
              "filesystem",
              "network"
            ],
            "properties": {
              "segment_id": { "type": "string", "minLength": 1 },
              "segment_policy_identity": { "$ref": "#/$defs/sha256Identity" },
              "filesystem": { "enum": ["enforced", "advisory", "unsupported"] },
              "network": { "enum": ["enforced", "advisory", "unsupported"] }
            }
          }
        },
        "refusals": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "sandboxAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "resolution",
        "provider_target",
        "canonical_policy",
        "restriction_overlay_identities",
        "effective_policy",
        "provider_evaluation"
      ],
      "properties": {
        "decision": { "const": "admitted" },
        "resolution": { "enum": ["explicit", "automatic"] },
        "provider_target": { "const": "oci_local" },
        "canonical_policy": { "$ref": "#/$defs/sandboxCanonicalPolicy" },
        "restriction_overlay_identities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "effective_policy": { "$ref": "#/$defs/sandboxEffectivePolicy" },
        "provider_evaluation": { "$ref": "#/$defs/sandboxProviderEvaluation" },
        "application_plan_identity": {
          "$ref": "#/$defs/sha256Identity"
        }
      }
    },
    "sandboxAdmissionError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "requested_target",
        "resolved_target",
        "canonical_policy_identity",
        "restriction_overlay_identities",
        "effective_policy_identity",
        "refusals",
        "supported_alternatives",
        "message"
      ],
      "properties": {
        "kind": { "type": "string" },
        "requested_target": { "type": ["string", "null"] },
        "resolved_target": { "type": ["string", "null"] },
        "canonical_policy_identity": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "restriction_overlay_identities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "effective_policy_identity": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "refusals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "control",
              "required",
              "capability",
              "reason"
            ],
            "properties": {
              "segment_id": { "type": "string" },
              "control": { "type": "string" },
              "required": { "type": "string" },
              "capability": {
                "enum": ["enforced", "advisory", "unsupported"]
              },
              "reason": { "type": "string" }
            }
          }
        },
        "supported_alternatives": {
          "type": "array",
          "items": { "type": "string" }
        },
        "message": { "type": "string" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependency_chain": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependency_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task", "backend", "backend_selection_source"],
            "properties": {
              "task": { "type": "string" },
              "parent": { "type": "string" },
              "backend": { "type": "string" },
              "context": { "type": "string" },
              "backend_selection_source": { "type": "string" },
              "prepare": { "$ref": "./tasks.json#/$defs/taskPrepareSummary" }
            }
          }
        },
        "requirement_lines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "staged_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "stage_family"],
            "properties": {
              "action": { "type": "string" },
              "stage_family": {
                "type": "string",
                "enum": ["prepare", "setup", "verify", "proof", "receipt"]
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "governanceRunnableMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "command"],
      "properties": {
        "mode": { "type": "string" },
        "default": { "type": "boolean" },
        "command": { "type": "string" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "resolution", "terminal_available"],
      "properties": {
        "posture": { "enum": ["auto", "forbidden", "required"] },
        "resolution": { "enum": ["terminal_passthrough", "piped", "refused"] },
        "terminal_available": { "type": "boolean" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safety_posture",
        "review_required",
        "effective_safe_for_agent",
        "default_mode",
        "network",
        "receipt_follow_up_command"
      ],
      "properties": {
        "safety_posture": {
          "enum": ["agent_safe", "declared_safe_closure_unsafe", "review_required"]
        },
        "review_required": { "type": "boolean" },
        "declared_safe_for_agent": { "type": "boolean" },
        "effective_safe_for_agent": { "type": "boolean" },
        "unsafe_closure_tasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "default_mode": { "type": "string" },
        "runnable_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/governanceRunnableMode" }
        },
        "network": { "type": "boolean" },
        "network_kind": {
          "enum": ["broad", "dependency_hydration", "container_image_hydration", "service_readiness", "integration_test", "tool_bootstrap"]
        },
        "writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "adapter_state": {
          "type": "array",
          "items": { "type": "string" }
        },
        "external_state": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sandbox_policy": { "$ref": "./tasks.json#/$defs/harnessSandboxPolicy" },
        "receipt_follow_up_command": { "type": "string" },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preflight", "post_execution"],
          "properties": {
            "preflight": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "evidence_classes", "receipt_expected", "proof_expected"],
              "properties": {
                "state": {
                  "enum": ["allowed", "refused", "blocked", "warning_only"]
                },
                "sandbox_admission": {
                  "oneOf": [
                    { "$ref": "#/$defs/sandboxAdmission" },
                    { "$ref": "#/$defs/sandboxAdmissionError" }
                  ]
                },
                "review_required": { "type": "boolean" },
                "declared_safe_for_agent": { "type": "boolean" },
                "effective_safe_for_agent": { "type": "boolean" },
                "unsafe_closure_tasks": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "refusal_reason_family": { "type": "string" },
                "refusal": { "$ref": "./tasks.json#/$defs/governanceRefusalRecord" },
                "decision_basis": {
                  "type": "array",
                  "items": { "$ref": "./tasks.json#/$defs/governanceDecisionBasisEntry" }
                },
                "decision_inputs": {
                  "type": "array",
                  "items": { "$ref": "./tasks.json#/$defs/governanceDecisionInputEntry" }
                },
                "replay": { "$ref": "./tasks.json#/$defs/governanceReplayResult" },
                "evidence_classes": {
                  "$ref": "./tasks.json#/$defs/governancePreflightEvidenceClasses"
                },
                "crossing_required": { "type": "boolean" },
                "crossing_classification": { "type": "string" },
                "crossing_boundary_family": { "type": "string" },
                "receipt_expected": { "type": "boolean" },
                "proof_expected": { "type": "boolean" }
              }
            },
            "post_execution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "execution_attempted",
                "refusal_occurred",
                "crossing_record_state",
                "receipt_present",
                "proof_present"
              ],
              "properties": {
                "state": {
                  "enum": ["not_run", "refused", "evidence_satisfied", "evidence_missing"]
                },
                "execution_attempted": { "type": "boolean" },
                "refusal_occurred": { "type": "boolean" },
                "refusal_reason_family": { "type": "string" },
                "refusal": { "$ref": "./tasks.json#/$defs/governanceRefusalRecord" },
                "not_run_reason": { "type": "string" },
                "crossing_record_state": { "type": "string" },
                "decision_basis": {
                  "type": "array",
                  "items": { "$ref": "./tasks.json#/$defs/governanceDecisionBasisEntry" }
                },
                "decision_inputs": {
                  "type": "array",
                  "items": { "$ref": "./tasks.json#/$defs/governanceDecisionInputEntry" }
                },
                "replay": { "$ref": "./tasks.json#/$defs/governanceReplayResult" },
                "evidence_classes": {
                  "$ref": "./tasks.json#/$defs/governancePostExecutionEvidenceClasses"
                },
                "receipt_present": { "type": "boolean" },
                "proof_present": { "type": "boolean" },
                "receipt_status": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "singleTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "path",
        "contract",
        "task",
        "dry_run",
        "execution_started",
        "preview_status",
        "summary",
        "contract_identity",
        "resolved",
        "requested_task",
        "env_summary",
        "governance",
        "plan"
      ],
      "properties": {
        "ok": { "type": "boolean" },
        "path": { "type": "string" },
        "contract": { "type": "string" },
        "member": { "type": "string" },
        "task": { "type": "string" },
        "dry_run": { "const": true },
        "execution_started": { "const": false },
        "preview_status": {
          "enum": ["RUNNABLE", "RUNNABLE WITH WARNINGS", "BLOCKED"]
        },
        "summary": { "$ref": "./doctor.json#/properties/summary" },
        "contract_identity": {
          "$ref": "./receipt.json#/oneOf/0/properties/receipt/properties/contract_identity"
        },
        "declared_execution": { "$ref": "./execution.json#/$defs/declaredExecution" },
        "resolved": { "$ref": "./execution.json#/oneOf/0/properties/resolved" },
        "overrides": { "$ref": "./execution.json#/oneOf/0/properties/overrides" },
        "requested_task": { "$ref": "./tasks.json#/oneOf/0/properties/tasks/items" },
        "interaction": { "$ref": "#/$defs/interaction" },
        "requested_context": { "type": "string" },
        "selected_context": { "type": "string" },
        "env_summary": { "$ref": "#/$defs/envSummary" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/envSourceEntry" }
        },
        "env": {
          "type": "array",
          "items": { "$ref": "#/$defs/envEntry" }
        },
        "toolchains": {
          "type": "array",
          "items": { "$ref": "./receipt.json#/oneOf/0/properties/receipt/properties/toolchains/items" }
        },
        "native_prerequisites": {
          "type": "array",
          "items": {
            "$ref": "./receipt.json#/oneOf/0/properties/receipt/properties/native_prerequisites/items"
          }
        },
        "provisioning": { "$ref": "./doctor.json#/properties/provisioning" },
        "provisioning_request": { "$ref": "./doctor.json#/properties/provisioning_request" },
        "governance": { "$ref": "#/$defs/governance" },
        "sandbox_admission": { "$ref": "#/$defs/sandboxAdmission" },
        "crossing_grant_admission": {
          "$ref": "#/$defs/crossingGrantAdmission"
        },
        "replay_input_policy": { "$ref": "./doctor.json#/$defs/replayInputPolicy" },
        "artifact_routing": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/artifactRoute" }
        },
        "plan": { "$ref": "#/$defs/plan" }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "task", "dry_run", "members"],
      "properties": {
        "ok": { "type": "boolean" },
        "path": { "type": "string" },
        "task": { "type": "string" },
        "dry_run": { "const": true },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/singleTarget" }
        }
      }
    },
    "simpleFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "task", "dry_run", "error"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "task": { "type": "string" },
        "dry_run": { "const": true },
        "execution_started": { "const": false },
        "code": { "type": "string" },
        "error": { "type": "string" },
        "replay_input_policy": { "$ref": "./doctor.json#/$defs/replayInputPolicy" }
      }
    },
    "crossingGrantAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "authority_id",
        "authority_binding_identity",
        "issuer_id",
        "key_id",
        "key_fingerprint",
        "bundle_id",
        "bundle_identity",
        "bundle_sequence",
        "grant_id",
        "grant_identity",
        "scope_identity",
        "contract_identity",
        "boundary_family",
        "classification",
        "actor_mode",
        "environment_posture",
