{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/proof-lifecycle.json",
  "title": "ota proof lifecycle --json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "proof_verdict",
    "path",
    "mode",
    "workflow",
    "phase",
    "stage_family",
    "proof_scope",
    "transaction_id",
    "services",
    "finalization"
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "proof_verdict": {
      "type": "string",
      "enum": ["passed", "passed_with_unproven_boundaries", "failed"]
    },
    "path": { "type": "string" },
    "mode": { "const": "lifecycle-proof" },
    "workflow": { "type": "string" },
    "phase": { "const": "lifecycle" },
    "stage_family": { "const": "proof" },
    "proof_scope": { "$ref": "#/$defs/proofScope" },
    "transaction_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/serviceRecord" }
    },
    "finalization": { "$ref": "#/$defs/finalization" },
    "assertion": { "$ref": "#/$defs/assertion" },
    "not_proved": {
      "type": "array",
      "items": { "$ref": "#/$defs/proofNotProved" }
    },
    "archive": { "$ref": "#/$defs/archive" },
    "error": { "type": "string" }
  },
  "$defs": {
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "path"],
      "properties": {
        "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "path": { "type": "string" }
      }
    },
    "proofScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "proof_class"],
      "properties": {
        "kind": { "const": "lifecycle_transition" },
        "proof_class": { "const": "slice_proof" },
        "workflow": { "type": "string" },
        "task": { "type": "string" },
        "intent": { "type": "string" }
      }
    },
    "proofNotProved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_to", "source"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["service_started_state_not_proved", "service_stopped_state_not_proved", "application_output_not_proved", "broader_repo_completion_not_proved"]
        },
        "relative_to": { "type": "string" },
        "source": { "type": "string", "enum": ["contract_lane", "proof_scope", "scope"] },
        "dependency_id": { "type": "string" },
        "proof_obligation_id": { "type": "string" },
        "reason": { "type": "string" },
        "declared_by_tasks": { "type": "array", "items": { "type": "string" } },
        "declared_by_workflows": { "type": "array", "items": { "type": "string" } }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["not_run", "not_declared", "command_succeeded", "command_failed", "state_observed", "state_not_observed", "boundary_terminated", "interrupted"]
        },
        "evidence_class": { "type": "string", "enum": ["derived", "attested"] }
      }
    },
    "finalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "after_interruption", "evidence_class"],
      "properties": {
        "state": { "type": "string", "enum": ["not_run", "completed", "completed_after_interruption", "incomplete", "incomplete_after_interruption"] },
        "after_interruption": { "type": "boolean" },
        "evidence_class": { "const": "attested" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "state", "output_truncated", "evidence_class"],
      "properties": {
        "task": { "type": "string" },
        "state": { "type": "string", "enum": ["passed", "failed", "interrupted"] },
        "exit_code": { "type": "integer" },
        "stdout_tail": { "type": "string" },
        "stderr_tail": { "type": "string" },
        "output_truncated": { "type": "boolean" },
        "evidence_class": { "const": "attested" }
      }
    },
    "serviceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "transaction_id", "preexisting_state", "cleanup_lease", "ownership", "start", "readiness", "teardown", "teardown_assertion"],
      "properties": {
        "service": { "type": "string" },
        "transaction_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "preexisting_state": { "type": "string", "enum": ["inactive_observed", "active_observed", "boundary_absent_attested", "unknown"] },
        "cleanup_lease": { "type": "string", "enum": ["not_acquired", "acquired", "released", "cleanup_failed"] },
        "ownership": { "type": "string", "enum": ["started_this_transaction", "reused_preexisting", "unknown"] },
        "start": { "$ref": "#/$defs/transition" },
        "readiness": { "$ref": "#/$defs/transition" },
        "teardown": { "$ref": "#/$defs/transition" },
        "teardown_assertion": { "$ref": "#/$defs/transition" }
      }
    }
  }
}
