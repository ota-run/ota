{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/proof-lifecycle.json",
  "title": "ota proof lifecycle --json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "proof_verdict",
    "path",
    "mode",
    "workflow",
    "phase",
    "stage_family",
    "proof_scope",
    "transaction_id",
    "services",
    "finalization",
    "not_proved"
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "proof_verdict": {
      "type": "string",
      "enum": ["passed_with_unproven_boundaries", "failed"]
    },
    "path": { "type": "string" },
    "mode": { "const": "lifecycle-proof" },
    "workflow": { "type": "string" },
    "phase": { "const": "lifecycle" },
    "stage_family": { "const": "proof" },
    "proof_scope": { "$ref": "#/$defs/proofScope" },
    "transaction_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/serviceRecord" }
    },
    "finalization": { "$ref": "#/$defs/finalization" },
    "assertion": { "$ref": "#/$defs/assertion" },
    "not_proved": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/proofNotProved" }
    },
    "archive": { "$ref": "#/$defs/archive" },
    "error": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "proof_verdict": { "const": "passed_with_unproven_boundaries" } }, "required": ["proof_verdict"] },
      "then": {
        "properties": {
          "ok": { "const": true },
          "services": { "minItems": 1 },
          "finalization": { "properties": { "state": { "enum": ["completed", "completed_after_interruption"] } }, "required": ["state"] }
        }
      }
    },
    {
      "if": { "properties": { "proof_verdict": { "const": "failed" } }, "required": ["proof_verdict"] },
      "then": {
        "required": ["error"],
        "properties": { "ok": { "const": false } }
      }
    },
    { "properties": { "not_proved": { "contains": { "properties": { "kind": { "const": "application_output_not_proved" } }, "required": ["kind"] } } } },
    { "properties": { "not_proved": { "contains": { "properties": { "kind": { "const": "broader_repo_completion_not_proved" } }, "required": ["kind"] } } } }
  ],
  "$defs": {
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "path"],
      "properties": {
        "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "path": { "type": "string" }
      }
    },
    "proofScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "proof_class"],
      "properties": {
        "kind": { "const": "lifecycle_transition" },
        "proof_class": { "const": "slice_proof" },
        "workflow": { "type": "string" },
        "task": { "type": "string" },
        "intent": { "type": "string" }
      }
    },
    "proofNotProved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_to", "source"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["service_started_state_not_proved", "service_stopped_state_not_proved", "application_output_not_proved", "broader_repo_completion_not_proved"]
        },
        "relative_to": { "type": "string" },
        "source": { "type": "string", "enum": ["contract_lane", "proof_scope", "scope"] },
        "dependency_id": { "type": "string" },
        "proof_obligation_id": { "type": "string" },
        "reason": { "type": "string" },
        "declared_by_tasks": { "type": "array", "items": { "type": "string" } },
        "declared_by_workflows": { "type": "array", "items": { "type": "string" } }
      }
    },
    "startTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["not_run", "command_succeeded", "command_failed", "interrupted"]
        },
        "evidence_class": { "type": "string", "enum": ["derived", "attested"] }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "not_run" } }, "required": ["state"] }, "then": { "not": { "required": ["evidence_class"] } } },
        { "if": { "properties": { "state": { "enum": ["command_succeeded", "command_failed", "interrupted"] } }, "required": ["state"] }, "then": { "properties": { "evidence_class": { "const": "attested" } }, "required": ["evidence_class"] } }
      ]
    },
    "readinessTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["not_run", "not_declared", "state_observed", "state_not_observed", "interrupted"] },
        "evidence_class": { "type": "string", "enum": ["derived", "attested"] }
      },
      "allOf": [
        { "if": { "properties": { "state": { "enum": ["not_run", "not_declared"] } }, "required": ["state"] }, "then": { "not": { "required": ["evidence_class"] } } },
        { "if": { "properties": { "state": { "enum": ["state_observed", "state_not_observed"] } }, "required": ["state"] }, "then": { "properties": { "evidence_class": { "const": "derived" } }, "required": ["evidence_class"] } },
        { "if": { "properties": { "state": { "const": "interrupted" } }, "required": ["state"] }, "then": { "properties": { "evidence_class": { "const": "attested" } }, "required": ["evidence_class"] } }
      ]
    },
    "teardownAssertionTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["not_run", "state_observed", "state_not_observed", "boundary_terminated"] },
        "evidence_class": { "type": "string", "enum": ["derived", "attested"] }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "not_run" } }, "required": ["state"] }, "then": { "not": { "required": ["evidence_class"] } } },
        { "if": { "properties": { "state": { "const": "state_observed" } }, "required": ["state"] }, "then": { "properties": { "evidence_class": { "const": "derived" } }, "required": ["evidence_class"] } },
        { "if": { "properties": { "state": { "const": "state_not_observed" } }, "required": ["state"] }, "then": { "required": ["evidence_class"] } },
        { "if": { "properties": { "state": { "const": "boundary_terminated" } }, "required": ["state"] }, "then": { "properties": { "evidence_class": { "const": "attested" } }, "required": ["evidence_class"] } }
      ]
    },
    "finalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "after_interruption", "evidence_class"],
      "properties": {
        "state": { "type": "string", "enum": ["not_run", "completed", "completed_after_interruption", "incomplete", "incomplete_after_interruption"] },
        "after_interruption": { "type": "boolean" },
        "evidence_class": { "const": "attested" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "state", "output_truncated", "evidence_class"],
      "properties": {
        "task": { "type": "string" },
        "state": { "type": "string", "enum": ["passed", "failed", "interrupted"] },
        "exit_code": { "type": "integer" },
        "stdout_tail": { "type": "string" },
        "stderr_tail": { "type": "string" },
        "output_truncated": { "type": "boolean" },
        "evidence_class": { "const": "attested" }
      }
    },
    "serviceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "transaction_id", "preexisting_state", "cleanup_lease", "ownership", "start", "readiness", "teardown", "teardown_assertion"],
      "properties": {
        "service": { "type": "string" },
        "transaction_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "boundary_identity": { "type": "string", "minLength": 1 },
        "preexisting_state": { "type": "string", "enum": ["inactive_observed", "active_observed", "boundary_absent_attested", "unknown"] },
        "cleanup_lease": { "type": "string", "enum": ["not_acquired", "acquired", "released", "cleanup_failed"] },
        "ownership": { "type": "string", "enum": ["started_this_transaction", "reused_preexisting", "unknown"] },
        "start": { "$ref": "#/$defs/startTransition" },
        "readiness": { "$ref": "#/$defs/readinessTransition" },
        "teardown": { "$ref": "#/$defs/startTransition" },
        "teardown_assertion": { "$ref": "#/$defs/teardownAssertionTransition" }
      },
      "allOf": [
        {
          "if": { "required": ["boundary_identity"] },
          "then": {
            "properties": {
              "teardown_assertion": {
                "properties": {
                  "state": { "enum": ["not_run", "state_not_observed", "boundary_terminated"] }
                },
                "allOf": [
                  {
                    "if": { "properties": { "state": { "const": "state_not_observed" } }, "required": ["state"] },
                    "then": { "properties": { "evidence_class": { "const": "attested" } } }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "teardown_assertion": {
                "allOf": [
                  {
                    "if": { "properties": { "state": { "const": "state_not_observed" } }, "required": ["state"] },
                    "then": { "properties": { "evidence_class": { "const": "derived" } } }
                  }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "teardown_assertion": { "properties": { "state": { "const": "state_observed" } }, "required": ["state"] } }, "required": ["teardown_assertion"] },
          "then": { "properties": { "cleanup_lease": { "const": "released" } } }
        },
        {
          "if": { "properties": { "teardown_assertion": { "properties": { "state": { "const": "state_not_observed" } }, "required": ["state"] } }, "required": ["teardown_assertion"] },
          "then": { "properties": { "cleanup_lease": { "const": "cleanup_failed" } } }
        },
        {
          "if": { "properties": { "teardown_assertion": { "properties": { "state": { "const": "not_run" } }, "required": ["state"] } }, "required": ["teardown_assertion"] },
          "then": { "properties": { "cleanup_lease": { "const": "not_acquired" } } }
        },
        {
          "if": { "properties": { "teardown_assertion": { "properties": { "state": { "const": "boundary_terminated" } }, "required": ["state"] } }, "required": ["teardown_assertion"] },
          "then": {
            "required": ["boundary_identity"],
            "properties": {
              "preexisting_state": { "const": "boundary_absent_attested" },
              "cleanup_lease": { "const": "released" },
              "ownership": { "const": "started_this_transaction" }
            }
          }
        }
      ]
    }
  }
}
