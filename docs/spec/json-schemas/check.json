{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/check.json",
  "title": "ota check --json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "path", "summary", "findings"],
  "$defs": {
    "toolchainSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider",
        "backend",
        "target_os",
        "version",
        "fulfillment",
        "required",
        "owns_runtime"
      ],
      "properties": {
        "name": { "type": "string" },
        "provider": { "type": "string" },
        "backend": { "type": "string" },
        "target_os": { "type": "string" },
        "version": { "type": "string" },
        "fulfillment": { "enum": ["none", "run"] },
        "required": { "type": "boolean" },
        "owns_runtime": { "type": "string" },
        "fulfilled": { "type": "boolean" },
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "owns_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "targets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "properties": {
    "ok": { "type": "boolean" },
    "path": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "agent_verdict", "error_count", "warn_count", "info_count"],
      "properties": {
        "verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "agent_verdict": {
          "enum": ["ready", "risky", "not_ready", "policy_blocked", "agent_blocked"]
        },
        "error_count": { "type": "integer", "minimum": 0 },
        "warn_count": { "type": "integer", "minimum": 0 },
        "info_count": { "type": "integer", "minimum": 0 },
        "primary_blocker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["severity", "summary", "why", "next"],
          "properties": {
            "severity": { "enum": ["error", "warn", "info"] },
            "summary": { "type": "string" },
            "why": { "type": "string" },
            "next": { "type": "string" }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "./shared.json#/$defs/finding" }
    },
    "toolchains": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolchainSelection" }
    },
    "finding_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_key", "action_title", "action_next", "count"],
        "properties": {
          "action_key": { "type": "string" },
          "action_title": { "type": "string" },
          "action_next": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "ok", "findings"],
        "properties": {
          "member": { "type": "string" },
          "ok": { "type": "boolean" },
          "toolchains": {
            "type": "array",
            "items": { "$ref": "#/$defs/toolchainSelection" }
          },
          "findings": {
            "type": "array",
            "items": { "$ref": "./shared.json#/$defs/finding" }
          }
        }
      }
    }
  }
}
