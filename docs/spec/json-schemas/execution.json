{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/execution.json",
  "title": "ota execution plan --json",
  "$defs": {
    "taskLaunchVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target"],
      "properties": {
        "kind": { "enum": ["named"] },
        "source": { "type": "string" },
        "target": { "type": "string" }
      }
    },
    "taskLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["command", "container"] },
        "exe": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "image": { "type": "string" },
        "engine": { "type": "string" },
        "name": { "type": "string" },
        "remove": { "type": "boolean" },
        "volumes": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskLaunchVolume" }
        }
      }
    },
    "workflowSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "intent": { "type": "string" },
        "description": { "type": "string" },
        "notes": { "type": "string" },
        "setup_task": { "type": "string" },
        "run_task": { "type": "string" },
        "run_task_launch": { "$ref": "#/$defs/taskLaunch" },
        "required_services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_probes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exposes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expose_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "executionContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": { "type": "string" }
      }
    },
    "executionRemote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string" },
        "target": { "type": "string" },
        "cwd": { "type": "string" }
      }
    },
    "executionBackends": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "container": { "$ref": "#/$defs/executionContainer" },
        "remote": { "$ref": "#/$defs/executionRemote" }
      }
    },
    "executionEnv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "source"],
      "properties": {
        "name": { "type": "string" },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "policy": { "type": "string" },
        "source": { "type": "string" },
        "allowed": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "executionContextAttachments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compose": {
          "type": "array",
          "items": { "type": "string" }
        },
        "isolated_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "isolated_effective_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "executionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "backend"],
      "properties": {
        "name": { "type": "string" },
        "backend": { "enum": ["native", "container", "remote"] },
        "lifecycle": { "enum": ["persistent", "ephemeral"] },
        "container": { "$ref": "#/$defs/executionContainer" },
        "remote": { "$ref": "#/$defs/executionRemote" },
        "attachments": { "$ref": "#/$defs/executionContextAttachments" }
      }
    },
    "declaredExecution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_context": { "type": "string" },
        "preferred": { "enum": ["native", "container", "remote"] },
        "supported": {
          "type": "array",
          "items": { "enum": ["native", "container", "remote"] }
        },
        "lifecycle": { "enum": ["persistent", "ephemeral"] },
        "backends": { "$ref": "#/$defs/executionBackends" },
        "contexts": {
          "type": "array",
          "items": { "$ref": "#/$defs/executionContext" }
        },
        "env": {
          "type": "array",
          "items": { "$ref": "#/$defs/executionEnv" }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "contract", "contract_identity", "resolved"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "contract": { "type": "string" },
        "member": { "type": "string" },
        "workflow": { "$ref": "#/$defs/workflowSummary" },
        "task": { "type": "string" },
        "contract_identity": {
          "$ref": "./receipt.json#/oneOf/0/properties/receipt/properties/contract_identity"
        },
        "declared_execution": { "$ref": "#/$defs/declaredExecution" },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "backend_source", "target_strategy"],
          "properties": {
            "backend": { "enum": ["native", "container", "remote"] },
            "backend_source": { "type": "string" },
            "lifecycle": { "enum": ["persistent", "ephemeral"] },
            "lifecycle_source": { "type": "string" },
            "image": { "type": "string" },
            "engine": { "type": "string" },
            "engine_candidates": {
              "type": "array",
              "items": { "type": "string" }
            },
            "provider": { "type": "string" },
            "target": { "type": "string" },
            "target_strategy": { "type": "string" },
            "cwd": { "type": "string" }
          }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backend": { "enum": ["native", "container", "remote"] },
            "lifecycle": { "enum": ["persistent", "ephemeral"] }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "member": { "type": "string" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error": { "type": "string" }
      }
    }
  ]
}
