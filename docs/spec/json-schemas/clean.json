{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/clean.json",
  "title": "ota clean --json",
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed_current_persistent_containers",
        "removed_drift_persistent_containers",
        "removed_drift_attached_containers",
        "removed_current_dependency_isolation_volumes",
        "removed_drift_dependency_isolation_volumes",
        "skipped_ambiguous_persistent_containers",
        "skipped_ambiguous_dependency_isolation_volumes",
        "stopped_host_services",
        "total_removed",
        "total_skipped_ambiguous"
      ],
      "properties": {
        "removed_current_persistent_containers": { "type": "integer" },
        "removed_drift_persistent_containers": { "type": "integer" },
        "removed_drift_attached_containers": { "type": "integer" },
        "removed_current_dependency_isolation_volumes": { "type": "integer" },
        "removed_drift_dependency_isolation_volumes": { "type": "integer" },
        "skipped_ambiguous_persistent_containers": { "type": "integer" },
        "skipped_ambiguous_dependency_isolation_volumes": { "type": "integer" },
        "stopped_host_services": { "type": "integer" },
        "total_removed": { "type": "integer" },
        "total_skipped_ambiguous": { "type": "integer" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "summary", "host_services", "queried_engines"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "summary": { "$ref": "#/$defs/summary" },
        "host_services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "queried_engines": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "classifiedFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "path",
        "summary",
        "error",
        "why",
        "next",
        "reason"
      ],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "summary": { "type": "string" },
        "error": { "type": "string" },
        "why": { "type": "string" },
        "next": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": {
          "enum": ["engine_unavailable", "active_execution_conflict", "other"]
        },
        "engine": { "type": "string" },
        "action": { "type": "string" },
        "resource_kind": {
          "enum": [
            "host_service",
            "persistent_container",
            "dependency_isolation_volume",
            "stale_containers"
          ]
        },
        "resource_name": { "type": ["string", "null"] },
        "details": { "type": "string" },
        "registry_path": { "type": "string" },
        "reasons": {
          "type": "array",
          "items": {
            "enum": [
              "active_execution_present",
              "host_service",
              "compose_project",
              "persistent_backend_family",
              "env_materialization_path",
              "write_path",
              "runtime_listener",
              "service_task"
            ]
          }
        },
        "active_execution_count": { "type": "integer", "minimum": 1 },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task",
              "execution_mode",
              "service_task",
              "pid",
              "started_at"
            ],
            "properties": {
              "task": { "type": "string" },
              "requested_mode": { "type": ["string", "null"] },
              "execution_mode": { "type": "string" },
              "lifecycle": { "type": ["string", "null"] },
              "host_services": {
                "type": "array",
                "items": { "type": "string" }
              },
              "compose_projects": {
                "type": "array",
                "items": { "type": "string" }
              },
              "persistent_backend_families": {
                "type": "array",
                "items": { "type": "string" }
              },
              "env_materialization_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "write_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "write_owners": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "namespace"],
                  "properties": {
                    "path": { "type": "string" },
                    "namespace": { "type": "string" }
                  }
                }
              },
              "runtime_owners": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["task", "namespace", "allocation"],
                  "properties": {
                    "task": { "type": "string" },
                    "listener": { "type": ["string", "null"] },
                    "namespace": { "type": "string" },
                    "protocol": { "type": ["string", "null"] },
                    "address": { "type": ["string", "null"] },
                    "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
                    "allocation": { "enum": ["fixed", "managed_dynamic", "isolated", "unresolved"] }
                  }
                }
              },
              "service_task": { "type": "boolean" },
              "pid": { "type": "integer", "minimum": 0 },
              "started_at": { "type": "string" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "reason": { "const": "active_execution_conflict" } },
            "required": ["reason"]
          },
          "then": {
            "required": ["registry_path", "reasons", "active_execution_count", "owners"]
          },
          "else": {
            "required": ["engine", "action", "resource_kind", "details"]
          }
        }
      ]
    },
    "genericFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "summary", "error"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "summary": { "type": "string" },
        "error": { "type": "string" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/classifiedFailure" },
    { "$ref": "#/$defs/genericFailure" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "summary", "host_services", "queried_engines"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "summary": { "$ref": "#/$defs/summary" },
        "host_services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "queried_engines": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "members"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["member", "report"],
            "properties": {
              "member": { "type": "string" },
              "report": { "$ref": "#/$defs/report" }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "workspace"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "members"],
          "properties": {
            "root": { "$ref": "#/$defs/report" },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["member", "report"],
                "properties": {
                  "member": { "type": "string" },
                  "report": { "$ref": "#/$defs/report" }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "scope", "dry_run", "engines", "summary", "containers"],
      "properties": {
        "ok": { "const": true },
        "scope": { "const": "stale" },
        "dry_run": { "type": "boolean" },
        "engines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matched_count", "removed_count", "would_remove_count"],
          "properties": {
            "matched_count": { "type": "integer" },
            "removed_count": { "type": "integer" },
            "would_remove_count": { "type": "integer" }
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engine", "name", "ownership"],
            "properties": {
              "engine": { "type": "string" },
              "name": { "type": "string" },
              "ownership": { "enum": ["label", "legacy_name"] }
            }
          }
        }
      }
    }
  ]
}
