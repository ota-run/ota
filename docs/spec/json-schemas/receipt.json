{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dist.ota.run/spec/json-schemas/latest/receipt.json",
  "title": "ota receipt --json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "mode", "summary", "receipt", "findings"],
      "properties": {
        "ok": { "type": "boolean" },
        "path": { "type": "string" },
        "mode": { "const": "receipt" },
        "archive_path": { "type": "string" },
        "promoted_baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "archive_path", "promoted_at"],
          "properties": {
            "path": { "type": "string" },
            "archive_path": { "type": "string" },
            "promoted_at": { "type": "string" }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["error_count", "warn_count", "info_count", "step_count"],
          "properties": {
            "error_count": { "type": "integer", "minimum": 0 },
            "warn_count": { "type": "integer", "minimum": 0 },
            "info_count": { "type": "integer", "minimum": 0 },
            "step_count": { "type": "integer", "minimum": 0 }
          }
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "path", "scope", "contract", "contract_identity", "steps", "summary"],
          "properties": {
            "ok": { "type": "boolean" },
            "path": { "type": "string" },
            "scope": { "const": "repo" },
            "contract": { "type": "string" },
            "contract_identity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "project", "counts"],
              "properties": {
                "version": { "type": "integer", "minimum": 1 },
                "project": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" }
                  }
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "owner": { "type": "string" },
                    "team": { "type": "string" },
                    "repo_class": { "type": "string" }
                  }
                },
                "execution": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "preferred": { "type": "string" },
                    "lifecycle": { "type": "string" },
                    "supported": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "image": { "type": "string" }
                  }
                },
                "counts": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["runtimes", "tools", "env", "services", "checks", "tasks"],
                  "properties": {
                    "runtimes": { "type": "integer", "minimum": 0 },
                    "tools": { "type": "integer", "minimum": 0 },
                    "env": { "type": "integer", "minimum": 0 },
                    "services": { "type": "integer", "minimum": 0 },
                    "checks": { "type": "integer", "minimum": 0 },
                    "tasks": { "type": "integer", "minimum": 0 },
                    "repos": { "type": "integer", "minimum": 0 },
                    "policies": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            },
            "workspace": { "type": "string" },
            "backend": { "type": "string" },
            "context": { "type": "string" },
            "lifecycle": { "type": "string" },
            "image": { "type": "string" },
            "container_memory_bytes": { "type": "integer", "minimum": 1 },
            "target": { "type": "string" },
            "provider": { "type": "string" },
            "cwd": { "type": "string" },
            "acquired": {
              "type": "array",
              "items": { "type": "string" }
            },
            "env": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "env_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value", "source"],
                "properties": {
                  "name": { "type": "string" },
                  "value": { "type": "string" },
                  "source": { "type": "string" }
                }
              }
            },
            "native_prerequisites": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "required", "platform"],
                "properties": {
                  "name": { "type": "string" },
                  "required": { "type": "boolean" },
                  "platform": { "type": "string" },
                  "check": { "type": "string" },
                  "activation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "applied"],
                    "properties": {
                      "kind": { "type": "string" },
                      "applied": { "type": "boolean" },
                      "arch": { "type": "string" },
                      "shell": { "type": "string" },
                      "run": { "type": "string" }
                    }
                  },
                  "requires": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["source"],
                    "properties": {
                      "runtimes": {
                        "type": "object",
                        "additionalProperties": { "type": "string" }
                      },
                      "tools": {
                        "type": "object",
                        "additionalProperties": { "type": "string" }
                      },
                      "toolchains": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "env": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "checks": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "source": { "type": "string" }
                    }
                  },
                  "provisioning": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "note": { "type": "string" }
                }
              }
            },
            "execution_conflict": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reasons"],
              "properties": {
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "toolchains": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "provider",
                  "backend",
                  "target_os",
                  "version",
                  "fulfillment",
                  "required",
                  "owns_runtime"
                ],
                "properties": {
                  "name": { "type": "string" },
                  "provider": { "type": "string" },
                  "backend": { "type": "string" },
                  "target_os": { "type": "string" },
                  "version": { "type": "string" },
                  "fulfillment": { "enum": ["none", "run"] },
                  "required": { "type": "boolean" },
                  "owns_runtime": { "type": "string" },
                  "fulfilled": { "type": "boolean" },
                  "commands": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "owns_tools": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "components": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "targets": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            },
            "policy": {
              "type": "array",
              "items": { "type": "string" }
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["order", "label", "status"],
                "properties": {
                  "order": { "type": "integer", "minimum": 1 },
                  "label": { "type": "string" },
                  "status": { "type": "string" },
                  "detail": { "type": "string" },
                  "exit_code": { "type": "integer" }
                }
              }
            },
            "status": { "type": "string" },
            "failed_task": { "type": "string" },
            "failed_dependency": { "type": "string" },
            "failure_origin": { "type": "string" },
            "blocked": {
              "type": "array",
              "items": { "type": "string" }
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["error_count", "warn_count", "info_count", "step_count"],
              "properties": {
                "error_count": { "type": "integer", "minimum": 0 },
                "warn_count": { "type": "integer", "minimum": 0 },
                "info_count": { "type": "integer", "minimum": 0 },
                "step_count": { "type": "integer", "minimum": 0 }
              }
            },
            "next": { "type": "string" },
            "next_steps": {
              "type": "array",
              "items": { "type": "string" }
            },
            "runtime": { "$ref": "./shared.json#/$defs/resolvedTaskRuntime" },
            "service_termination": {
              "$ref": "./shared.json#/$defs/serviceTermination"
            },
            "workloads": {
              "type": "object",
              "additionalProperties": {
                "$ref": "./shared.json#/$defs/resolvedTaskRuntime"
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/finding" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "path",
        "mode",
        "baseline",
        "current",
        "summary",
        "introduced",
        "resolved",
        "unchanged"
      ],
      "properties": {
        "ok": { "type": "boolean" },
        "path": { "type": "string" },
        "mode": { "const": "diff" },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "ok", "contract", "summary"],
          "properties": {
            "source": { "enum": ["latest", "promoted", "file"] },
            "selection_path": { "type": "string" },
            "archive_path": { "type": "string" },
            "archived_at": { "type": "string" },
            "promoted_at": { "type": "string" },
            "contract_identity": { "type": "string" },
            "contract_identity_details": {
              "$ref": "#/oneOf/0/properties/receipt/properties/contract_identity"
            },
            "ok": { "type": "boolean" },
            "contract": { "type": "string" },
            "status": { "type": "string" },
            "backend": { "type": "string" },
            "target": { "type": "string" },
            "provider": { "type": "string" },
            "context": { "type": "string" },
            "lifecycle": { "type": "string" },
            "cwd": { "type": "string" },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["error_count", "warn_count", "info_count", "step_count"],
              "properties": {
                "error_count": { "type": "integer", "minimum": 0 },
                "warn_count": { "type": "integer", "minimum": 0 },
                "info_count": { "type": "integer", "minimum": 0 },
                "step_count": { "type": "integer", "minimum": 0 },
                "repo_count": { "type": "integer", "minimum": 0 },
                "ready_count": { "type": "integer", "minimum": 0 },
                "not_ready_count": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "current": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "contract", "summary"],
          "properties": {
            "ok": { "type": "boolean" },
            "contract": { "type": "string" },
            "contract_identity": { "type": "string" },
            "contract_identity_details": {
              "$ref": "#/oneOf/0/properties/receipt/properties/contract_identity"
            },
            "backend": { "type": "string" },
            "status": { "type": "string" },
            "target": { "type": "string" },
            "provider": { "type": "string" },
            "context": { "type": "string" },
            "lifecycle": { "type": "string" },
            "cwd": { "type": "string" },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["error_count", "warn_count", "info_count", "step_count"],
              "properties": {
                "error_count": { "type": "integer", "minimum": 0 },
                "warn_count": { "type": "integer", "minimum": 0 },
                "info_count": { "type": "integer", "minimum": 0 },
                "step_count": { "type": "integer", "minimum": 0 },
                "repo_count": { "type": "integer", "minimum": 0 },
                "ready_count": { "type": "integer", "minimum": 0 },
                "not_ready_count": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_ok",
            "current_ok",
            "comparison",
            "introduced",
            "resolved",
            "unchanged"
          ],
          "properties": {
            "baseline_ok": { "type": "boolean" },
            "current_ok": { "type": "boolean" },
            "comparison": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "baseline_identity_label",
                "current_identity_label",
                "identity_changed",
                "readiness_change"
              ],
              "properties": {
                "baseline_identity_label": {
                  "type": "string"
                },
                "current_identity_label": {
                  "type": "string"
                },
                "identity_changed": {
                  "type": "boolean"
                },
                "readiness_change": {
                  "enum": [
                    "unchanged",
                    "improved",
                    "regressed"
                  ]
                }
              }
            },
            "introduced": {
              "type": "object",
              "additionalProperties": false,
              "required": ["count", "error_count", "warn_count", "info_count"],
              "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "error_count": { "type": "integer", "minimum": 0 },
                "warn_count": { "type": "integer", "minimum": 0 },
                "info_count": { "type": "integer", "minimum": 0 }
              }
            },
            "resolved": {
              "type": "object",
              "additionalProperties": false,
              "required": ["count", "error_count", "warn_count", "info_count"],
              "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "error_count": { "type": "integer", "minimum": 0 },
                "warn_count": { "type": "integer", "minimum": 0 },
                "info_count": { "type": "integer", "minimum": 0 }
              }
            },
            "unchanged": {
              "type": "object",
              "additionalProperties": false,
              "required": ["count", "error_count", "warn_count", "info_count"],
              "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "error_count": { "type": "integer", "minimum": 0 },
                "warn_count": { "type": "integer", "minimum": 0 },
                "info_count": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "passed", "new_blocker_count"],
          "properties": {
            "rule": { "const": "fail_on_new_blockers" },
            "passed": { "type": "boolean" },
            "new_blocker_count": {
              "type": "integer",
              "minimum": 0
            },
            "blocking_summary": {
              "type": "string"
            },
            "blocking_next": {
              "type": "string"
            },
            "blocking_provenance": {
              "type": "string"
            },
            "blocking_provenance_key": {
              "type": "string"
            }
          }
        },
        "introduced": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/finding" }
        },
        "resolved": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/finding" }
        },
        "unchanged": {
          "type": "array",
          "items": { "$ref": "./shared.json#/$defs/finding" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path", "mode", "summary", "archives"],
      "properties": {
        "ok": { "const": true },
        "path": { "type": "string" },
        "mode": { "const": "history" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["archive_count", "invalid_archive_count"],
          "properties": {
            "archive_count": { "type": "integer", "minimum": 0 },
            "invalid_archive_count": { "type": "integer", "minimum": 0 }
          }
        },
        "archives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["archive_path", "archived_at", "ok", "contract", "summary"],
            "properties": {
              "archive_path": { "type": "string" },
              "archived_at": { "type": "string" },
              "ok": { "type": "boolean" },
              "contract": { "type": "string" },
              "status": { "type": "string" },
              "backend": { "type": "string" },
              "target": { "type": "string" },
              "provider": { "type": "string" },
              "context": { "type": "string" },
              "lifecycle": { "type": "string" },
              "cwd": { "type": "string" },
              "summary": {
                "type": "object",
                "additionalProperties": false,
                "required": ["error_count", "warn_count", "info_count", "step_count"],
                "properties": {
                  "error_count": { "type": "integer", "minimum": 0 },
                  "warn_count": { "type": "integer", "minimum": 0 },
                  "info_count": { "type": "integer", "minimum": 0 },
                  "step_count": { "type": "integer", "minimum": 0 },
                  "repo_count": { "type": "integer", "minimum": 0 },
                  "ready_count": { "type": "integer", "minimum": 0 },
                  "not_ready_count": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "invalid_archives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["archive_path", "error"],
            "properties": {
              "archive_path": { "type": "string" },
              "error": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "path"],
      "properties": {
        "ok": { "const": false },
        "path": { "type": "string" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["error_count"],
          "properties": {
            "error_count": { "type": "integer" }
          }
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error": { "type": "string" }
      },
      "anyOf": [
        { "required": ["errors"] },
        { "required": ["error"] }
      ]
    }
  ]
}
